---
/**
 * A small, dim constellation for the hero sky: stars at `stars`, joined by `lines`
 * (each line is a list of star indexes), with a star-chart label underneath.
 * `wall` lists closed outlines (star indexes) that HeroConverge's dots may not cross,
 * or "hull" for the outline around all the stars.
 * A star can carry its real brightness (0-1) and color: [x, y, brightness?, color?].
 */
import { starHash, starLook } from "./starLook";

interface Props {
  stars: [number, number, number?, string?][];
  lines: number[][];
  label: string;
  viewBox: string;
  wall?: number[][] | "hull";
  class?: string;
}
const { stars, lines, label, viewBox, wall = [], class: className } = Astro.props;
const [vx, vy, vw, vh] = viewBox.split(" ").map(Number);
const xy = (i: number) => [stars[i][0], stars[i][1]];

// convex hull (monotone chain) of the stars, as indexes
function hull(): number[] {
  const idx = stars.map((_, i) => i).sort((a, b) => stars[a][0] - stars[b][0] || stars[a][1] - stars[b][1]);
  const cross = (o: number, a: number, b: number) =>
    (stars[a][0] - stars[o][0]) * (stars[b][1] - stars[o][1]) - (stars[a][1] - stars[o][1]) * (stars[b][0] - stars[o][0]);
  const half = (list: number[]) => {
    const h: number[] = [];
    for (const i of list) {
      while (h.length >= 2 && cross(h[h.length - 2], h[h.length - 1], i) <= 0) h.pop();
      h.push(i);
    }
    return h.slice(0, -1);
  };
  return [...half(idx), ...half([...idx].reverse())];
}
const rings = wall === "hull" ? [hull()] : wall;
const shape = rings.length ? JSON.stringify({ viewBox: [vx, vy, vw, vh], rings: rings.map((r) => r.map(xy)) }) : undefined;
const looks = stars.map(([x, y, b, c]) => {
  const h = b ?? starHash(x, y);
  return { x, y, h, ...starLook(h), ...(c ? { color: c, glow: c } : {}) };
});
const glowColors = [...new Set(looks.map((s) => s.glow))];
const gid = (c: string) => `mini-glow-${c.slice(1)}`;
---
<svg class:list={["mini", className]} viewBox={viewBox} data-shape={shape} xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    {
      glowColors.map((c) => (
        <radialGradient id={gid(c)}>
          <stop offset="0" stop-color={c} stop-opacity="0.9" />
          <stop offset="0.3" stop-color={c} stop-opacity="0.32" />
          <stop offset="1" stop-color={c} stop-opacity="0" />
        </radialGradient>
      ))
    }
  </defs>
  {lines.map((l) => <polyline points={l.map((i) => xy(i).join(",")).join(" ")} class="mini-line" />)}
  {
    looks.map((s) => (
      <g class="mini-star" style={`--d: ${(s.h * 3).toFixed(2)}s; --tw: ${s.twinkle}`}>
        <circle cx={s.x} cy={s.y} r={s.bloom} fill={`url(#${gid(s.glow)})`} opacity="0.3" />
        <circle cx={s.x} cy={s.y} r={s.halo + 0.8} fill={`url(#${gid(s.glow)})`} opacity="0.85" />
        {s.spike > 0 && <path d={`M${s.x - s.spike} ${s.y}H${s.x + s.spike}M${s.x} ${s.y - s.spike}V${s.y + s.spike}`} stroke={s.color} class="mini-spikes" />}
        <circle cx={s.x} cy={s.y} r={s.core + 0.9} fill={s.color} />
      </g>
    ))
  }
  <text x={vx + vw / 2} y={vy + vh - 1} text-anchor="middle" class="mini-label">{label}</text>
</svg>

<style>
  .mini {
    overflow: visible;
    opacity: 0.95;
  }
  .mini-line {
    fill: none;
    stroke: #a5bedb;
    stroke-opacity: 0.5;
    stroke-width: 1;
    stroke-linejoin: round;
  }
  /* each star scintillates on its own rhythm, already mid-cycle when the page opens */
  .mini-star {
    animation: mini-scint var(--tw) ease-in-out calc(-1 * var(--d)) infinite;
  }
  @keyframes mini-scint {
    0%,
    100% {
      opacity: 1;
    }
    13% {
      opacity: 0.78;
    }
    21% {
      opacity: 0.96;
    }
    37% {
      opacity: 0.6;
    }
    52% {
      opacity: 1;
    }
    68% {
      opacity: 0.84;
    }
    83% {
      opacity: 0.95;
    }
  }
  .mini-spikes {
    stroke-width: 0.45;
    stroke-opacity: 0.55;
    stroke-linecap: round;
  }
  .mini-label {
    fill: #a5bedb;
    font: 600 7px "Inter Variable", system-ui, sans-serif;
    letter-spacing: 0.4em;
  }
  @media (prefers-reduced-motion: reduce) {
    .mini-star {
      animation: none;
    }
  }
</style>
