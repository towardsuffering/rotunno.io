---
/**
 * The crossover as a constellation: Elvis's impact without Elvis. A 1950s broadcast microphone,
 * its grille a green neural network, sends its signal out in waves, and the waves reach four working
 * professionals (finance, analytics, retail, home services) who light up one after another: a sound
 * carried to people who'd never heard it, and SI carried to the people doing the work.
 * Same frame as the old Florida map, so HeroConverge's layout around it is unchanged.
 */
import { starHash, starLook } from "./starLook";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

type Pt = [number, number];
const VIEWBOX = [28, -20, 306, 214];

// the microphone: a rounded capsule head on a pole with a round base
const cap = { x: 74, y: 14, w: 52, h: 84, r: 26 };
const capsule = `M${cap.x + cap.r} ${cap.y}H${cap.x + cap.w - cap.r}A${cap.r} ${cap.r} 0 0 1 ${cap.x + cap.w} ${cap.y + cap.r}V${cap.y + cap.h - cap.r}A${cap.r} ${cap.r} 0 0 1 ${cap.x + cap.w - cap.r} ${cap.y + cap.h}H${cap.x + cap.r}A${cap.r} ${cap.r} 0 0 1 ${cap.x} ${cap.y + cap.h - cap.r}V${cap.y + cap.r}A${cap.r} ${cap.r} 0 0 1 ${cap.x + cap.r} ${cap.y}Z`;
const stand = ["M100 98V180", "M76 184a24 5 0 1 0 48 0a24 5 0 1 0 -48 0"];
const micStars: Pt[] = [[100, 14], [100, 98], [100, 180], [76, 184], [124, 184]];

// the grille is the SI: three layers wired together, feeding the brightest star on the capsule's edge
const layers: Pt[][] = [
  [[86, 40], [86, 56], [86, 72]],
  [[100, 32], [100, 48], [100, 64], [100, 80]],
  [[113, 44], [113, 68]],
];
const output: Pt = [126, 56];
const net: [Pt, Pt][] = [
  ...layers.slice(0, -1).flatMap((layer, i) => layer.flatMap((a) => layers[i + 1].map((b) => [a, b] as [Pt, Pt]))),
  ...layers.at(-1)!.map((b) => [b, output] as [Pt, Pt]),
];

// the broadcast: arcs spreading from the output toward the people it reaches
const waves = [18, 34, 50].map((r, i) => {
  const a = (46 * Math.PI) / 180;
  const [x1, y1] = [output[0] + r * Math.cos(-a), output[1] + r * Math.sin(-a)];
  const [x2, y2] = [output[0] + r * Math.cos(a), output[1] + r * Math.sin(a)];
  return { d: `M${x1.toFixed(1)} ${y1.toFixed(1)}A${r} ${r} 0 0 1 ${x2.toFixed(1)} ${y2.toFixed(1)}`, delay: `${(i * 0.5).toFixed(1)}s` };
});

// the professionals the signal reaches, each a head and shoulders with the mark of their trade
function person(cx: number, cy: number, mark: string[], label: string, delay: string) {
  const head = `M${cx - 6} ${cy - 8}a6 6 0 1 0 12 0a6 6 0 1 0 -12 0`;
  const shoulders = `M${cx - 13} ${cy + 14}Q${cx - 13} ${cy + 1} ${cx} ${cy + 1}Q${cx + 13} ${cy + 1} ${cx + 13} ${cy + 14}`;
  return {
    lines: [head, shoulders, ...mark],
    stars: [[cx - 13, cy + 14], [cx + 13, cy + 14], [cx, cy - 14]] as Pt[],
    glow: [cx, cy] as Pt,
    label: { x: cx, y: cy + 24, text: label },
    delay,
  };
}
const people = [
  // finance: a tie
  person(240, 6, ["M240 8L237.6 11L240 19L242.4 11Z"], "FINANCE", "0.8s"),
  // analytics: a laptop with a rising line on its screen
  person(292, 46, ["M285 49H299V58H285Z", "M282 60H302", "M287 56L291 53L294 54L297 51"], "ANALYTICS", "1.1s"),
  // retail: an apron bib on its straps
  person(292, 112, ["M286 126V118H298V126", "M286 118L289 114", "M298 118L295 114"], "RETAIL", "1.4s"),
  // home services: a hard hat
  person(240, 150, ["M231 142.5A9 9 0 0 1 249 142.5", "M229 142.5H251"], "HOME SERVICES", "1.7s"),
];

// the capsule is a wall for HeroConverge's dots
const capRing: Pt[] = Array.from({ length: 32 }, (_, i) => {
  const t = (i / 32) * Math.PI * 2;
  const [cx, cy] = [cap.x + cap.w / 2, cap.y + cap.h / 2];
  return [cx + (cap.w / 2) * Math.cos(t), cy + (cap.h / 2) * Math.sin(t)];
});
const shape = JSON.stringify({ viewBox: VIEWBOX, rings: [capRing] });

const stars = (pts: Pt[], green = false) => pts.map(([x, y]) => ({ x, y, h: starHash(x, y), ...starLook(starHash(x, y), green) }));
const lineStars = stars([...micStars, ...people.flatMap((p) => p.stars)]);
const mindStars = stars(layers.flat(), true);
const glowColors = [...new Set([...lineStars, ...mindStars].map((s) => s.glow))];
const gid = (c: string) => `cx-glow-${c.slice(1)}`;
const [ox, oy] = output;
---

<svg class={className} viewBox={VIEWBOX.join(" ")} data-shape={shape} xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    {
      glowColors.map((c) => (
        <radialGradient id={gid(c)}>
          <stop offset="0" stop-color={c} stop-opacity="0.9" />
          <stop offset="0.3" stop-color={c} stop-opacity="0.32" />
          <stop offset="1" stop-color={c} stop-opacity="0" />
        </radialGradient>
      ))
    }
    <radialGradient id="cx-star-glow-green">
      <stop offset="0" stop-color="#34d399" stop-opacity="0.7" />
      <stop offset="1" stop-color="#34d399" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- the microphone and its stand: soft glowing lines, like the figures of an old star atlas -->
  {[capsule, ...stand].map((d) => <path d={d} class="cx-glow" />)}
  {[capsule, ...stand].map((d) => <path d={d} class="cx-line" />)}
  <!-- its grille, the SI -->
  {net.map(([a, b]) => <line x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} class="cx-net" />)}

  <!-- the broadcast -->
  {waves.map((w) => <path d={w.d} class="cx-wave" style={`--wd: ${w.delay}`} />)}

  <!-- the professionals it reaches, each lighting up as the signal arrives -->
  {
    people.map((p) => (
      <g>
        <circle cx={p.glow[0]} cy={p.glow[1]} r="22" fill="url(#cx-star-glow-green)" class="cx-reached" style={`--rd: ${p.delay}`} />
        {p.lines.map((d) => <path d={d} class="cx-glow" />)}
        {p.lines.map((d) => <path d={d} class="cx-line" />)}
        {/* styled inline, so the label stays small and pale even where the dev server drops the scoped styles */}
        <text x={p.label.x} y={p.label.y} fill="#a5bedb" font-size="4.6" font-weight="600" font-family="Inter Variable, system-ui, sans-serif" letter-spacing="1.5" text-anchor="middle">{p.label.text}</text>
      </g>
    ))
  }

  {
    [...lineStars, ...mindStars].map((s) => (
      <g class="cx-star" style={`--d: ${(s.h * 3).toFixed(2)}s; --tw: ${s.twinkle}`}>
        <circle cx={s.x} cy={s.y} r={s.bloom} fill={`url(#${gid(s.glow)})`} opacity="0.3" />
        <circle cx={s.x} cy={s.y} r={s.halo} fill={`url(#${gid(s.glow)})`} opacity="0.85" />
        {s.spike > 0 && <path d={`M${s.x - s.spike} ${s.y}H${s.x + s.spike}M${s.x} ${s.y - s.spike}V${s.y + s.spike}`} stroke={s.color} class="cx-spikes" />}
        <circle cx={s.x} cy={s.y} r={s.core} fill={s.color} />
      </g>
    ))
  }

  <!-- the network's output, where the signal leaves: the brightest star -->
  <g>
    <circle cx={ox} cy={oy} r="12" fill="url(#cx-star-glow-green)" class="cx-core-glow" />
    <circle cx={ox} cy={oy} r="2.6" fill="#ecfdf5" />
    <path d={`M${ox} ${oy - 7}V${oy + 7}M${ox - 7} ${oy}H${ox + 7}`} class="cx-spike" />
  </g>
</svg>

<style>
  svg {
    overflow: visible;
  }
  .cx-line {
    fill: none;
    stroke: #c7d6ea;
    stroke-opacity: 0.55;
    stroke-width: 0.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* a soft halo under each line, so the figures glow instead of reading as wireframes */
  .cx-glow {
    fill: none;
    stroke: #7dd3fc;
    stroke-opacity: 0.09;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cx-net {
    stroke: #34d399;
    stroke-opacity: 0.4;
    stroke-width: 0.45;
  }
  /* dotted arcs, rippling outward one after another */
  .cx-wave {
    fill: none;
    stroke: #a7f3d0;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-dasharray: 0 4.5;
    animation: cx-broadcast 3s ease-out var(--wd) infinite;
  }
  @keyframes cx-broadcast {
    0%,
    100% {
      opacity: 0.2;
    }
    25% {
      opacity: 0.9;
    }
  }
  /* each person lights up green just after the waves reach them */
  .cx-reached {
    opacity: 0.15;
    animation: cx-light 3s ease-out var(--rd) infinite;
  }
  @keyframes cx-light {
    0%,
    100% {
      opacity: 0.15;
    }
    30% {
      opacity: 0.8;
    }
  }
  /* each star scintillates on its own rhythm, already mid-cycle when the page opens */
  .cx-star {
    animation: cx-scint var(--tw) ease-in-out calc(-1 * var(--d)) infinite;
  }
  @keyframes cx-scint {
    0%,
    100% {
      opacity: 1;
    }
    13% {
      opacity: 0.78;
    }
    21% {
      opacity: 0.96;
    }
    37% {
      opacity: 0.6;
    }
    52% {
      opacity: 1;
    }
    68% {
      opacity: 0.84;
    }
    83% {
      opacity: 0.95;
    }
  }
  .cx-spikes {
    stroke-width: 0.3;
    stroke-opacity: 0.55;
    stroke-linecap: round;
  }
  .cx-core-glow {
    animation: cx-pulse 2.6s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes cx-pulse {
    0%,
    100% {
      opacity: 0.7;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.25);
    }
  }
  .cx-spike {
    stroke: #ecfdf5;
    stroke-opacity: 0.7;
    stroke-width: 0.5;
  }
  @media (prefers-reduced-motion: reduce) {
    .cx-star,
    .cx-core-glow,
    .cx-wave,
    .cx-reached {
      animation: none;
    }
    .cx-wave {
      opacity: 0.6;
    }
    .cx-reached {
      opacity: 0.5;
    }
  }
</style>
