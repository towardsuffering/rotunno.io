---
import { Icon } from "astro-icon/components";

import Button from "@/components/button/Button.astro";
import ConfidenceConstellation from "@/components/hero/ConfidenceConstellation.astro";

// a faint star-chart grid behind the sky: declination arcs and right-ascension lines,
// drawn around a center far below the view so they curve gently across it
const GRID = (() => {
  const cx = 800, cy = 2900;
  const pt = (r: number, a: number) => [cx + r * Math.sin(a), cy - r * Math.cos(a)];
  const arcs = [2200, 2340, 2480, 2620, 2760, 2900].map((r) => {
    const a = Math.asin(900 / r);
    const [x1, y1] = pt(r, -a), [x2, y2] = pt(r, a);
    return `M${x1.toFixed(0)} ${y1.toFixed(0)}A${r} ${r} 0 0 1 ${x2.toFixed(0)} ${y2.toFixed(0)}`;
  });
  const spokes = [-0.3, -0.2, -0.1, 0, 0.1, 0.2, 0.3].map((a) => {
    const [x1, y1] = pt(2000, a), [x2, y2] = pt(3100, a);
    return `M${x1.toFixed(0)} ${y1.toFixed(0)}L${x2.toFixed(0)} ${y2.toFixed(0)}`;
  });
  return [...arcs, ...spokes];
})();

// Scroll-driven hero: the mission, the experience behind it (scattered points sort into the working world
// they came from), the approach (how SI reaches them: the blog and Tidbit of the Day), and the outcome
// (they spell "confidence").
const steps = [
  { tag: "02 / Experience", title: "Ten years. Four industries.", body: "Inside financial and operational data teams. Out on the floor in retail, food service, and home improvement sales. Each role left a fragment: a spreadsheet, a closing shift, a handoff that broke. Put together, they show where the numbers and the work drift apart." },
  { tag: "03 / Approach", title: "I connect the dots.", body: "Messy data gets structured. Patterns get caught before they become problems. Then super intelligence turns the answer into plain English: a blog post with a notebook anyone can run, or a daily Tidbit on LinkedIn." },
  { tag: "04 / Outcome", title: "Confidence you can act on.", body: "The goal was never a prettier chart. It's the moment someone stops guessing and makes the call." },
];
---

<section id="converge" class="converge" aria-label="Hero section">
  <div class="converge__sticky">
    <!-- the copy comes first in the markup so the browser reaches (and paints) the headline before the
         heavy constellation SVGs below; stacking is set by z-index, so it still draws on top -->
    <div class="converge__captions">
      <div class="converge__step converge__step--hero is-active" data-step="0">
        <p class="converge__tag">01 / Analytics Engineer</p>
        <h1 class="converge__headline font-heading">
          Turning fragmented tidbits <span class="converge__headline-si">into confidence.</span>
        </h1>
        <p class="converge__why">I structure messy data, fix broken handoffs, and catch patterns before they become problems. Then I use super intelligence to make the answers plain for the people doing the work.</p>
        <div class="flex flex-wrap gap-4">
          <Button href="/blog" variant="primary" class="md:text-lg">
            <div class="flex items-center gap-2">
              <span>Read the Blog</span>
              <Icon name="tabler/arrow-narrow-right" aria-hidden="true" class="size-5" />
            </div>
          </Button>
          <a
            href="/Rotunno_Resume.pdf"
            download="Rotunno_Resume.pdf"
            aria-label="Download CV"
            class="inline-flex items-center gap-2 px-4 py-2 text-white/70 transition-colors hover:text-white md:text-lg"
          >
            <Icon name="tabler/download" aria-hidden="true" class="size-5" />
            <span>Download CV</span>
          </a>
        </div>
      </div>
      {
        steps.map((s, i) => (
          <div class="converge__step" data-step={i + 1}>
            <p class="converge__tag">{s.tag}</p>
            <h2 class="converge__title">{s.title}</h2>
            <p class="converge__body">{s.body}</p>
          </div>
        ))
      }
    </div>

    <!-- deep space: faint nebulae and the Milky Way band, behind everything -->
    <div class="converge__space" aria-hidden="true" data-sky></div>
    <!-- thousands of tiny distant stars, painted once per size (see paintStarfield) -->
    <div class="converge__stars" aria-hidden="true"></div>
    <!-- star-chart grid, the faintest layer of the sky -->
    <svg class="converge__grid" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" data-sky>
      {GRID.map((d) => <path d={d} />)}
    </svg>
    <!-- fragments into confidence as a constellation, under the particles; it fades as the shapes take over -->
    <div class="converge__map" data-map data-sky>
      <ConfidenceConstellation class="h-full w-full" />
    </div>
    <canvas id="converge-canvas" aria-hidden="true"></canvas>
    <!-- over the dots, so they drift behind it, softened but still bright -->
    <div class="converge__plate" aria-hidden="true" data-plate data-sky></div>

    <div class="converge__rail" aria-hidden="true">
      {[0, 1, 2, 3].map((i) => <span data-dot={i} class:list={{ "is-active": i === 0 }} />)}
    </div>

    <div class="converge__hint">
      <p class="converge__hint-action" aria-hidden="true">Scroll <span>↓</span><span class="converge__hint-cursor"> &nbsp;·&nbsp; move your cursor to connect the dots</span></p>
    </div>
  </div>
</section>

<style>
  .converge {
    position: relative;
    height: 380vh;
    background: radial-gradient(ellipse at 50% 0%, #0c1f3d 0%, #050d1c 55%, #02060e 100%);
    color: #e6f1ff;
    /* the hero's sky dissolves into the site-wide one behind it over its last stretch, instead of
       ending on a hard line; the pinned scene fades with it as it scrolls away */
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 50vh), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 50vh), transparent);
  }
  .converge__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  .converge__map {
    position: absolute;
    top: 50%;
    right: calc(max(0px, (100% - 86rem) / 2) + 16px);
    /* as big as the space right of the captions allows: page width, minus the container margins,
       the caption column (its 64px inset plus up to 520px), and a 24px gap */
    width: min(
      960px,
      calc(100% - 2 * max(0px, (100% - 86rem) / 2) - 64px - min(520px, 40vw) - 16px - 24px)
    );
    aspect-ratio: 306 / 214;
    transform: translateY(-50%);
    pointer-events: none;
    transition: opacity 0.3s linear;
  }
  /* desktop: one frosted glass plate over the sky and under the copy, wrapping the headline and the signal
     (sized in placeMap); light enough that the dots passing behind it stay clearly visible */
  .converge__plate {
    position: absolute;
    z-index: 1;
    border: 1px solid rgba(165, 190, 219, 0.12);
    border-radius: 28px;
    background: linear-gradient(160deg, rgba(12, 26, 50, 0.42), rgba(4, 10, 22, 0.34));
    box-shadow: 0 24px 70px -24px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    /* frosted: dots behind it soften and dim, but still show through */
    backdrop-filter: blur(1.5px);
    -webkit-backdrop-filter: blur(1.5px);
    pointer-events: none;
    transition: opacity 0.3s linear;
  }
  /* placeMap sizes the plate from the measured copy; until it has, it stays unpainted, so it
     appears in place instead of jumping there (a layout shift Lighthouse counts) */
  .converge:not([data-placed]) .converge__plate {
    visibility: hidden;
  }
  /* phones: the signal's spot comes from the copy's height too */
  @media (max-width: 767px) {
    .converge:not([data-placed]) .converge__map {
      visibility: hidden;
    }
  }
  /* layered: dots, then the plate, then the signal and the copy on top, crisp */
  .converge__map {
    z-index: 2;
  }
  .converge__captions {
    z-index: 3;
  }
  @media (max-width: 767px) {
    .converge__plate {
      display: none;
    }
  }
  @media (max-width: 767px) {
    /* phones: in the open space under the captions; --map-top is measured from the copy (see placeMap) */
    .converge__map {
      top: var(--map-top, max(330px, 44%));
      right: 16px;
      left: 16px;
      width: auto;
      max-height: calc(100% - var(--map-top, max(330px, 44%)) - 36px);
      transform: none;
    }
  }
  .converge__space,
  .converge__stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .converge__space {
    transition: opacity 0.3s linear;
    background:
      /* teal nebula behind the signal, violet one low on the left */
      radial-gradient(ellipse 38% 30% at 74% 42%, rgba(52, 211, 153, 0.07), transparent 70%),
      radial-gradient(ellipse 30% 24% at 16% 82%, rgba(139, 92, 246, 0.07), transparent 70%),
      radial-gradient(ellipse 26% 18% at 88% 12%, rgba(56, 189, 248, 0.05), transparent 70%),
      /* the Milky Way: a soft diagonal band of light */
      linear-gradient(
        118deg,
        transparent 28%,
        rgba(150, 175, 215, 0.035) 40%,
        rgba(200, 212, 240, 0.075) 49%,
        rgba(225, 215, 235, 0.06) 52%,
        rgba(150, 175, 215, 0.035) 60%,
        transparent 72%
      );
  }
  @media (min-width: 768px) {
    /* desktop: the deeper sky from the LinkedIn cover, richer nebulae and a brighter Milky Way */
    .converge__space {
      background:
        radial-gradient(ellipse 34% 34% at 74% 42%, rgba(52, 211, 153, 0.13), transparent 70%),
        radial-gradient(ellipse 18% 20% at 82% 16%, rgba(45, 212, 191, 0.07), transparent 70%),
        radial-gradient(ellipse 30% 30% at 12% 88%, rgba(139, 92, 246, 0.14), transparent 70%),
        radial-gradient(ellipse 22% 22% at 34% 8%, rgba(99, 102, 241, 0.07), transparent 70%),
        radial-gradient(ellipse 26% 22% at 94% 4%, rgba(56, 189, 248, 0.1), transparent 70%),
        radial-gradient(ellipse 22% 20% at 56% 100%, rgba(168, 85, 247, 0.07), transparent 70%),
        linear-gradient(
          118deg,
          transparent 24%,
          rgba(150, 175, 215, 0.055) 37%,
          rgba(200, 212, 240, 0.11) 48%,
          rgba(235, 220, 240, 0.095) 52%,
          rgba(150, 175, 215, 0.055) 62%,
          transparent 74%
        );
    }
  }
  .converge__stars {
    background-size: 100% 100%;
    opacity: 0.9;
  }
  .converge__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    transition: opacity 0.3s linear;
  }
  .converge__grid path {
    fill: none;
    stroke: #a5bedb;
    stroke-opacity: 0.08;
    stroke-width: 1;
    stroke-dasharray: 2 6;
    vector-effect: non-scaling-stroke;
  }
  #converge-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: crosshair;
  }
  .converge__captions {
    position: absolute;
    /* lines up with the site name in the header: the site container's edge (86rem wide, 16px padding)
       plus the logo mark (40px) and its gap (8px) */
    left: calc(max(0px, (100% - 86rem) / 2) + 16px + 48px);
    top: 50%;
    transform: translateY(-50%);
    width: min(520px, 40vw);
    pointer-events: none;
  }
  .converge__step {
    position: absolute;
    width: 100%;
    top: 0;
    transform: translateY(-50%);
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .converge__step.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  /* the opening copy: a headline with weight, then one plain line on what the work is */
  .converge__headline {
    max-width: 14em;
    text-wrap: balance;
    margin: 0 0 1.1rem;
    font-size: clamp(2.6rem, 5.2vw, 4.3rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: #f4f8ff;
    background: linear-gradient(180deg, #ffffff 0%, #eef3fb 55%, #b9c6da 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 24px rgba(120, 170, 255, 0.18));
  }
  /* the second line, a size down so the headline reads as a statement, not a wall of type */
  /* the payoff, in the same green as the confidence star */
  .converge__headline-si {
    background: linear-gradient(180deg, #a7f3d0 0%, #34d399 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .converge__why {
    max-width: 30rem;
    margin: 0 0 2.25rem;
    font-size: clamp(1.05rem, 1.35vw, 1.3rem);
    line-height: 1.45;
    color: rgba(226, 234, 246, 0.82);
  }
  @media (max-width: 767px) {
    .converge__headline {
      font-size: clamp(2rem, 10.3vw, 3rem);
      margin-bottom: 0.9rem;
    }
    .converge__why {
      margin-bottom: 1.2rem;
    }
  }
  /* short phones (most phones once the browser's bars are counted): a tighter stack, so
     the signal gets real room under the buttons */
  @media (max-width: 767px) and (max-height: 800px) {
    .converge__headline {
      margin-bottom: 0.7rem;
    }
    .converge__why {
      margin-bottom: 1rem;
      font-size: 1rem;
    }
    .converge__step--hero .flex-wrap {
      row-gap: 0.25rem;
    }
  }
  .converge__tag {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #34d399;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .converge__title {
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.15;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .converge__body {
    color: #9fb3cc;
    font-size: 1rem;
    line-height: 1.55;
  }
  .converge__rail {
    position: absolute;
    right: clamp(16px, 3vw, 40px);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .converge__rail span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #2a3d57;
    transition: background 0.3s, transform 0.3s;
  }
  .converge__rail span.is-active {
    background: #34d399;
    transform: scale(1.5);
  }
  .converge__hint {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.8rem;
    color: #7f93ad;
    text-align: center;
    white-space: nowrap;
  }
  @media (hover: none), (pointer: coarse) {
    .converge__hint-cursor {
      display: none;
    }
  }
  .converge__hint-action {
    transition: opacity 0.4s;
  }
  .converge__hint-note {
    transition: opacity 0.4s, visibility 0.4s;
    margin-top: 4px;
    font-size: 0.7rem;
    color: #8aa0bb;
    font-style: italic;
  }
  .converge__hint-action > span:first-child {
    display: inline-block;
    animation: converge-bob 1.6s ease-in-out infinite;
  }
  @keyframes converge-bob {
    50% { transform: translateY(4px); }
  }

  @media (max-width: 767px) {
    /* phones: captions sit at the top under the nav, the shapes draw below them */
    .converge__captions {
      top: 144px;
      transform: none;
      width: auto;
      right: 16px;
    }
    .converge__step {
      transform: none;
    }
    .converge__hint {
      bottom: 14px;
      font-size: 0.7rem;
    }
    /* the step dots already say there's more; the space goes to the signal */
    .converge__hint-action {
      display: none;
    }
    /* both buttons on one row */
    .converge__step--hero .flex-wrap {
      flex-wrap: nowrap;
      align-items: center;
      gap: 0.5rem;
    }
    .converge__step--hero .flex-wrap > :first-child {
      padding-inline: 1rem;
      white-space: nowrap;
    }
    .converge__step--hero .flex-wrap > a:last-child {
      padding-inline: 0.25rem;
      font-size: 0.875rem;
      white-space: nowrap;
    }
  }
</style>


<script>
  type Pt = { x: number; y: number };
  type Particle = {
    x: number; y: number; // rendered position
    seed: number; // 0..1, staggers each particle's transition
    phase: number; // drift phase for the chaos stage
    group: number; // industry cluster
    size: number;
  };

  const GROUPS = ["Financial Services", "Retail", "Food Service", "Home Improvement"];
  const GROUP_COLORS = ["#38bdf8", "#a78bfa", "#f59e0b", "#34d399"];
  // scattered points look like real stars: mostly blue-white, some hot blue, a few warm
  const CHAOS_COLORS = ["#dbe7fb", "#c4d4ee", "#9fb3cf", "#7f93b0", "#b9cdf5", "#f4e6cc", "#f1d2ae"];
  const STAGES = 4;

  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const clamp01 = (t: number) => Math.min(1, Math.max(0, t));
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  function hexToRgb(hex: string) {
    const n = parseInt(hex.slice(1), 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }
  type RGB = number[];
  const mixRgb = (A: RGB, B: RGB, t: number): RGB => [lerp(A[0], B[0], t), lerp(A[1], B[1], t), lerp(A[2], B[2], t)];
  const css = (c: RGB) => `rgb(${c[0] | 0},${c[1] | 0},${c[2] | 0})`;

  function init() {
    const section = document.getElementById("converge");
    const canvas = document.getElementById("converge-canvas") as HTMLCanvasElement | null;
    if (!section || !canvas) return;
    const ctx = canvas.getContext("2d")!;
    const steps = [...section.querySelectorAll<HTMLElement>("[data-step]")];
    const dots = [...section.querySelectorAll<HTMLElement>("[data-dot]")];
    const hint = section.querySelector<HTMLElement>(".converge__hint-action");
    const note = section.querySelector<HTMLElement>(".converge__hint-note");
    // the disclaimer leaves entirely once the hero starts dissolving into the page below (its last 50vh)
    const placeNote = () => {
      if (!note) return;
      const gone = section.getBoundingClientRect().bottom < window.innerHeight * 1.5;
      note.style.opacity = gone ? "0" : "1";
      note.style.visibility = gone ? "hidden" : "visible";
    };
    const sky = [...section.querySelectorAll<HTMLElement>("[data-sky]")];
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // view transitions keep this script alive across pages; stop when the hero leaves
    let alive = true;
    const ac = new AbortController();
    const signal = ac.signal;
    document.addEventListener("astro:before-swap", () => { alive = false; ac.abort(); }, { once: true });
    // once the hero has scrolled away, skip drawing without measuring the page every frame
    let onScreen = true;
    const io = new IntersectionObserver(([entry]) => (onScreen = entry.isIntersecting));
    io.observe(section);
    signal.addEventListener("abort", () => io.disconnect());
    placeNote();
    window.addEventListener("scroll", placeNote, { passive: true, signal });
    window.addEventListener("resize", placeNote, { signal });

    let W = 0, H = 0, dpr = 1, mobile = false;
    let particles: Particle[] = [];
    let targets: Pt[][] = []; // [stage][particle]
    let colors: RGB[][] = [];
    const q = new URLSearchParams(location.search);
    const mouse = { x: Number(q.get("mx") ?? -9999), y: Number(q.get("my") ?? -9999) };

    // the area the shapes are drawn in, leaving room for captions
    function stage() {
      if (mobile) {
        // below the tallest step's text, so the shapes never run into a caption
        const y = Math.max(305, H * 0.4, captionsBottom + 34);
        return { x: 16, y, w: W - 32, h: Math.max(200, H - y - 56) };
      }
      // shapes start clear of the captions, which line up with the site name
      const left = Math.max(Math.min(W * 0.42, 560), captionsRight + 40);
      return { x: left, y: H * 0.14, w: W - left - 80, h: H * 0.72 };
    }

    // constellation borders are walls: `inside` marks their shapes, `clear` adds a margin around them
    let inside: Uint8Array | null = null;
    let copyBox: { x0: number; y0: number; x1: number; y1: number } | null = null; // dots here fade (see draw)
    let clear: Uint8Array | null = null;
    const hit = (m: Uint8Array | null, x: number, y: number) =>
      !!m && x >= 0 && y >= 0 && x < W && y < H && m[(y | 0) * W + (x | 0)] === 1;

    function buildWall() {
      const c = canvas!.getBoundingClientRect();
      const off = document.createElement("canvas");
      off.width = W; off.height = H;
      const o = off.getContext("2d")!;
      o.beginPath();
      // the signal and every visible small constellation; hidden ones measure zero and are skipped
      section!.querySelectorAll<SVGSVGElement>("svg[data-shape]").forEach((svg) => {
        const r = svg.getBoundingClientRect();
        if (!r.width || !r.height) return;
        const data = JSON.parse(svg.dataset.shape!) as { viewBox: number[]; rings: number[][][] };
        const [vx, vy, vw, vh] = data.viewBox;
        // the svg scales its viewBox to fit, centered (preserveAspectRatio's default)
        const k = Math.min(r.width / vw, r.height / vh);
        const ox = r.left - c.left + (r.width - vw * k) / 2 - vx * k;
        const oy = r.top - c.top + (r.height - vh * k) / 2 - vy * k;
        for (const raw of data.rings) {
          // same winding for every ring, so overlapping shapes add up instead of cancelling out
          const area = raw.reduce((sum, [x, y], i) => {
            const [nx, ny] = raw[(i + 1) % raw.length];
            return sum + x * ny - nx * y;
          }, 0);
          const ring = area < 0 ? [...raw].reverse() : raw;
          ring.forEach(([x, y], i) => (i ? o.lineTo : o.moveTo).call(o, ox + x * k, oy + y * k));
          o.closePath();
        }
      });
      // dots may pass behind the opening copy, faded there so the text stays clean (see draw):
      // on a phone the copy covers most of the screen, and on desktop the glass plate sets it apart
      const copy = section!.querySelector<HTMLElement>(".converge__step--hero");
      const cr = copy?.getBoundingClientRect();
      copyBox = null;
      if (cr && cr.width) {
        const x0 = cr.left - c.left - 12, y0 = cr.top - c.top - 8;
        copyBox = { x0, y0, x1: x0 + cr.width + 24, y1: y0 + cr.height + 16 };
      }
      const read = () => {
        const d = o.getImageData(0, 0, W, H).data, m = new Uint8Array(W * H);
        for (let i = 0; i < m.length; i++) m[i] = d[i * 4 + 3] > 0 ? 1 : 0;
        return m;
      };
      // "evenodd" would punch holes where shapes overlap, and so would opposite windings under the
      // default rule, so fill with nonzero after making every subpath wind the same way (see below)
      o.fill("nonzero");
      inside = read();
      o.lineWidth = 34; // drift and the cursor pocket never reach a border from here
      o.lineJoin = "round";
      o.stroke();
      clear = read();
    }

    // phones: the signal sits under the hero copy, which wraps to a different height on every phone
    function placeMap() {
      const el = section!.querySelector<HTMLElement>("[data-map]");
      const hero = section!.querySelector<HTMLElement>(".converge__step--hero");
      if (!el || !hero) return;
      if (W >= 768) {
        el.style.removeProperty("--map-top");
        // the plate wraps the headline and the signal
        const plate = section!.querySelector<HTMLElement>("[data-plate]");
        if (!plate) return;
        const c = canvas!.getBoundingClientRect(), h = hero.getBoundingClientRect(), m = el.getBoundingClientRect();
        const pad = 28;
        const l = Math.min(h.left, m.left) - c.left - pad, r = m.left + m.width - c.left + pad;
        // never up into the nav on short screens
        const nav = document.querySelector("header")?.getBoundingClientRect().bottom ?? 0;
        const t = Math.max(nav + 8, Math.min(h.top, m.top) - pad) - c.top, b = Math.max(h.bottom, m.bottom) - c.top + pad;
        Object.assign(plate.style, { left: `${l}px`, top: `${t}px`, width: `${r - l}px`, height: `${b - t}px` });

        markPlaced();
        return;
      }
      const top = hero.getBoundingClientRect().bottom - canvas!.getBoundingClientRect().top + 4;
      el.style.setProperty("--map-top", `${Math.round(top)}px`);
      markPlaced();
    }

    // show the placed pieces once the web font is in, since the swap re-wraps the copy and would move them again
    function markPlaced() {
      if (document.fonts.status === "loaded") section!.dataset.placed = "";
      else document.fonts.ready.then(placeMap);
    }

    // thousands of faint background stars, thicker along the Milky Way band
    function paintStarfield() {
      const el = section!.querySelector<HTMLElement>(".converge__stars");
      if (!el) return;
      // seeded, so a repaint (a phone's address bar sliding) draws the same sky, not a new one
      let seed = 20260917;
      const rand = () => {
        seed = (seed + 0x6d2b79f5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
      const sf = document.createElement("canvas");
      sf.width = Math.round(W * dpr); sf.height = Math.round(H * dpr);
      const g = sf.getContext("2d")!;
      g.scale(dpr, dpr);
      const temps = ["220,232,255", "200,218,255", "255,240,214", "255,226,190", "180,200,235"];
      // band axis matches the CSS Milky Way (118deg): unit normal of the band through the center
      const ang = ((118 - 90) * Math.PI) / 180, nx = Math.cos(ang), ny = Math.sin(ang);
      const count = Math.round((W * H) / (mobile ? 1300 : 520)); // phones get a sparser sky
      // the caption block (its active step) keeps a quieter patch of sky, so the copy stays crisp
      const c = canvas!.getBoundingClientRect();
      const step = section!.querySelector<HTMLElement>(".converge__step.is-active") ?? section!.querySelector<HTMLElement>(".converge__step");
      const cr = step?.getBoundingClientRect();
      const quiet = cr ? { l: cr.left - c.left - 30, r: cr.right - c.left + 30, t: cr.top - c.top - 30, b: cr.bottom - c.top + 30 } : null;
      for (let i = 0; i < count; i++) {
        const x = rand() * W, y = rand() * H;
        const d = Math.abs((x - W / 2) * nx + (y - H / 2) * ny) / Math.max(W, H);
        if (rand() > 0.35 + 0.65 * Math.exp(-((d / 0.12) ** 2))) continue; // denser near the band
        if (hit(clear, x, y)) continue;
        // desktop gets the cover's brighter sky: larger stars, and the biggest ones glow
        const r = mobile
          ? (rand() < 0.94 ? 0.25 + rand() * 0.45 : 0.7 + rand() * 0.5)
          : (rand() < 0.94 ? 0.28 + rand() * 0.45 : 0.8 + rand() * 0.7);
        // (desktop's plate already sets the copy apart, so its stars stay brighter there)
        const dim = quiet && x > quiet.l && x < quiet.r && y > quiet.t && y < quiet.b ? (mobile ? 0.12 : 0.8) : !mobile && y < 110 ? 0.45 : 1; // and the nav stays quiet on desktop
        const col = temps[Math.floor(rand() * temps.length)];
        const a = (mobile ? 0.15 + rand() * 0.5 : 0.18 + rand() * 0.5) * dim;
        if (!mobile && r > 1.25) {
          const gl = g.createRadialGradient(x, y, 0, x, y, r * 4);
          gl.addColorStop(0, `rgba(${col},${(a * 0.35).toFixed(2)})`);
          gl.addColorStop(1, `rgba(${col},0)`);
          g.fillStyle = gl;
          g.beginPath();
          g.arc(x, y, r * 4, 0, Math.PI * 2);
          g.fill();
        }
        g.fillStyle = `rgba(${col},${a.toFixed(2)})`;
        g.beginPath();
        g.arc(x, y, r, 0, Math.PI * 2);
        g.fill();
      }
      // and a handful of bright flare stars out in the open sky, away from the copy
      for (let i = 0, placed = 0; !mobile && placed < 7 && i < 200; i++) {
        const x = rand() * W, y = rand() * H;
        if (hit(clear, x, y) || y < 130 || y > H - 120 || (quiet && x > quiet.l - 40 && x < quiet.r + 40 && y > quiet.t - 40 && y < quiet.b + 40)) continue;
        const sz = 3 + (placed % 3) * 1.6;
        const gl = g.createRadialGradient(x, y, 0, x, y, sz * 3.2);
        gl.addColorStop(0, "rgba(220,232,255,.5)");
        gl.addColorStop(1, "rgba(220,232,255,0)");
        g.fillStyle = gl;
        g.beginPath();
        g.arc(x, y, sz * 3.2, 0, Math.PI * 2);
        g.fill();
        g.strokeStyle = "rgba(230,240,255,.5)";
        g.lineWidth = 0.6;
        g.beginPath();
        g.moveTo(x - sz * 2, y); g.lineTo(x + sz * 2, y);
        g.moveTo(x, y - sz * 2); g.lineTo(x, y + sz * 2);
        g.stroke();
        g.fillStyle = "#f4f8ff";
        g.beginPath();
        g.arc(x, y, 1.2 + (placed % 3) * 0.35, 0, Math.PI * 2);
        g.fill();
        placed++;
      }
      el.style.backgroundImage = `url(${sf.toDataURL("image/png")})`;
    }

    function scatterPoint(): Pt {
      let pt = { x: Math.random() * W, y: Math.random() * H };
      for (let tries = 0; tries < 30 && hit(clear, pt.x, pt.y); tries++) pt = { x: Math.random() * W, y: Math.random() * H };
      return pt;
    }

    function chaosTargets(): Pt[] {
      return particles.map(scatterPoint);
    }

    function clusterTargets(): Pt[] {
      const s = stage();
      const cols = mobile ? 2 : 4;
      const rows = mobile ? 2 : 1;
      const cw = s.w / cols, ch = s.h / rows;
      const r = Math.min(cw, ch) * 0.32;
      return particles.map((p) => {
        const cx = s.x + cw * ((p.group % cols) + 0.5);
        const cy = s.y + ch * (Math.floor(p.group / cols) + 0.45);
        // sunflower spiral packing: dense, round, organic
        const k = Math.random();
        const a = p.seed * 2399.96;
        return { x: cx + Math.cos(a) * r * Math.sqrt(k), y: cy + Math.sin(a) * r * Math.sqrt(k) };
      });
    }

    function chartTargets(): Pt[] {
      const s = stage();
      const bars = mobile ? 8 : 12;
      const gap = s.w / bars;
      const bw = gap * 0.6;
      const heights = Array.from({ length: bars }, (_, i) => 0.16 + 0.84 * Math.pow((i + 1) / bars, 1.4) - (i % 4 === 2 ? 0.06 : 0));
      // pick a dot spacing so the bars hold every particle on a tidy grid
      const area = heights.reduce((a, h) => a + bw * h * s.h * 0.9, 0);
      const sp = Math.sqrt(area / particles.length);
      const base = s.y + s.h * 0.95;
      const out: Pt[] = [];
      for (let b = 0; b < bars && out.length < particles.length; b++) {
        const cols = Math.max(1, Math.floor(bw / sp));
        const x0 = s.x + gap * b + (gap - (cols - 1) * sp) / 2;
        const rows = Math.round((heights[b] * s.h * 0.9) / sp);
        for (let r = 0; r < rows; r++)
          for (let c = 0; c < cols; c++) out.push({ x: x0 + c * sp, y: base - r * sp });
      }
      // leftovers stack on top of the tallest bar's column
      while (out.length < particles.length) out.push(out[out.length - 1 - Math.floor(Math.random() * 40)]);
      out.length = particles.length;
      return shuffle(out);
    }

    function wordTargets(): Pt[] {
      const s = stage();
      const off = document.createElement("canvas");
      const ow = Math.max(1, Math.floor(s.w)), oh = Math.max(1, Math.floor(s.h));
      off.width = ow; off.height = oh;
      const o = off.getContext("2d")!;
      const word = mobile ? "trusted." : "confidence.";
      let size = oh * 0.5;
      o.font = `900 ${size}px "Inter Variable", system-ui, sans-serif`;
      size = Math.min(size, (size * ow * 0.96) / o.measureText(word).width);
      o.font = `900 ${size}px "Inter Variable", system-ui, sans-serif`;
      o.textAlign = "center";
      o.textBaseline = "middle";
      o.fillStyle = "#fff";
      o.fillText(word, ow / 2, oh / 2);
      const data = o.getImageData(0, 0, ow, oh).data;
      let filled = 0;
      for (let i = 3; i < data.length; i += 4) if (data[i] > 140) filled++;
      // one grid point per particle, so the letters come out crisp
      const sp = Math.max(2, Math.sqrt(filled / particles.length));
      const pts: Pt[] = [];
      for (let y = sp / 2; y < oh; y += sp)
        for (let x = sp / 2; x < ow; x += sp)
          if (data[(Math.floor(y) * ow + Math.floor(x)) * 4 + 3] > 140) pts.push({ x: s.x + x, y: s.y + y });
      if (!pts.length) return chaosTargets();
      shuffle(pts);
      return particles.map((_, i) => pts[i % pts.length]);
    }

    function shuffle<T>(a: T[]) {
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    let builtWidth = -1, builtHeight = -1;
    let captionsRight = 0; // right edge of the caption column, in canvas pixels
    let captionsBottom = 0; // phones: bottom edge of the tallest scroll step's text, in canvas pixels
    let labelY: number[] = []; // bottom edge of each formed cluster
    // the build runs in short slices with a break between them, so the page stays responsive while the
    // sky is set up (one long task here showed up as Lighthouse "blocking time" on slow phones);
    // a newer build (a resize mid-way) cancels an older one at its next break
    let buildRun = 0;
    const nextTask = () => new Promise<void>((r) => setTimeout(r, 0));
    async function build() {
      const run = ++buildRun;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas!.clientWidth;
      H = canvas!.clientHeight;
      // in-app browsers (Facebook, LinkedIn) can lay the page out in a hidden or
      // zero-size webview first; wait for a real viewport before building shapes
      if (W < 50 || H < 50) return;
      mobile = W < 768;
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      placeMap();
      buildWall();
      await nextTask();
      if (run !== buildRun) return;
      paintStarfield(); // after the walls, so no background star sits inside a constellation
      // the map can move on resize; scattered points it now covers find a new spot
      if (targets[0]) targets[0] = targets[0].map((t) => (hit(clear, t.x, t.y) ? scatterPoint() : t));
      // a height-only resize (phone address bar sliding) keeps every point where it is
      if (W === builtWidth && Math.abs(H - builtHeight) < 160) return;
      builtWidth = -1; // draw() pauses while the points and targets are rebuilt
      await nextTask();
      if (run !== buildRun) return;
      const cap = section!.querySelector<HTMLElement>(".converge__captions");
      captionsRight = cap ? cap.getBoundingClientRect().right - canvas!.getBoundingClientRect().left : 0;
      const canvasTop = canvas!.getBoundingClientRect().top;
      captionsBottom = Math.max(
        0,
        ...[...section!.querySelectorAll<HTMLElement>(".converge__step:not(.converge__step--hero)")].map((el) => el.getBoundingClientRect().bottom - canvasTop),
      );

      const count = mobile ? 800 : 2400;
      if (particles.length !== count) {
        particles = Array.from({ length: count }, (_, i) => ({
          x: 0,
          y: 0,
          seed: Math.random(),
          phase: Math.random() * Math.PI * 2,
          group: i % GROUPS.length,
          size: 1.1 + Math.random() * 1.1,
        }));
      }
      const chaos = chaosTargets(), cluster = clusterTargets(), chart = chartTargets();
      await nextTask();
      if (run !== buildRun) return;
      targets = [chaos, cluster, chart, wordTargets()];
      labelY = GROUPS.map(() => 0);
      particles.forEach((p, i) => (labelY[p.group] = Math.max(labelY[p.group], targets[1][i].y)));
      const s = stage();
      const lo = hexToRgb("#0ea5e9"), hi = hexToRgb("#7dd3fc");
      colors = [
        particles.map(() => hexToRgb(CHAOS_COLORS[Math.floor(Math.random() * CHAOS_COLORS.length)])),
        particles.map((p) => hexToRgb(GROUP_COLORS[p.group])),
        targets[2].map((t) => mixRgb(lo, hi, clamp01((s.y + s.h - t.y) / s.h))),
        particles.map(() => hexToRgb(Math.random() < 0.85 ? "#34d399" : "#a7f3d0")),
      ];
      // start every point on its scattered spot, so nothing streaks across the screen on load
      particles.forEach((p, i) => {
        p.x = targets[0][i].x;
        p.y = targets[0][i].y;
      });
      // last, so draw() only runs once every part is in place
      builtWidth = W;
      builtHeight = H;
    }

    const forced = new URLSearchParams(location.search).get("p");
    function progress() {
      if (forced !== null) return clamp01(parseFloat(forced));
      const r = section!.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      return clamp01(-r.top / span);
    }

    let lastActive = -1;
    function frame(time: number) {
      try {
        draw(time);
      } catch (err) {
        console.error(err);
      }
      if (alive) requestAnimationFrame(frame);
    }

    function draw(time: number) {
      if (builtWidth < 0) return;
      if (!onScreen) return;
      // each step holds fully formed for the outer 20% of its scroll range on each side,
      // so the shape is in focus wherever a swipe happens to stop near it
      const raw = progress() * (STAGES - 1);
      const seg = Math.min(STAGES - 2, Math.floor(raw));
      const s = seg + clamp01((raw - seg - 0.2) / 0.6);
      const k = Math.min(STAGES - 2, Math.floor(s));
      const local = s - k;
      const active = Math.round(s);

      if (active !== lastActive) {
        steps.forEach((el, i) => el.classList.toggle("is-active", i === active));
        dots.forEach((el, i) => el.classList.toggle("is-active", i === active));
        lastActive = active;
      }
      if (hint) hint.style.opacity = s < 0.15 ? "1" : "0";
      const mapAlpha = clamp01(1 - s * 2.5);
      sky.forEach((el) => (el.style.opacity = String(mapAlpha)));

      ctx.clearRect(0, 0, W, H);
      const t = time / 1000;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        // stagger: each particle starts and finishes its move at a slightly different moment
        const lt = ease(clamp01((local - p.seed * 0.35) / 0.65));
        const a = targets[k][i], b = targets[k + 1][i];
        let tx = lerp(a.x, b.x, lt);
        let ty = lerp(a.y, b.y, lt);

        // chaos drift fades out as structure takes over
        const drift = reduce ? 0 : (1 - clamp01(s)) * 14 + 0.3;
        tx += Math.sin(t * 0.6 + p.phase) * drift;
        ty += Math.cos(t * 0.5 + p.phase * 1.3) * drift;

        // cursor clears a small pocket; the spring brings points back
        const dx = tx - mouse.x, dy = ty - mouse.y;
        const d2 = dx * dx + dy * dy;
        const R = mobile ? 30 : 46;
        if (d2 < R * R) {
          const d = Math.sqrt(d2) || 1;
          const f = (1 - d / R) * R * 0.9;
          tx += (dx / d) * f;
          ty += (dy / d) * f;
        }

        const spring = forced !== null || reduce ? 1 : 0.14;
        const nx = p.x + (tx - p.x) * spring, ny = p.y + (ty - p.y) * spring;
        // while the signal is on screen, no dot crosses its border; it waits at the edge instead
        if (!(mapAlpha > 0.02 && hit(inside, nx, ny) && !hit(inside, p.x, p.y))) {
          p.x = nx;
          p.y = ny;
        } else if (k === 0) {
          // blocked at a border: rather than wait there (and pile up along the coast), head for a new open spot
          targets[0][i] = scatterPoint();
        }

        frameColors[i] = mixRgb(colors[k][i], colors[k + 1][i], lt);
      }

      const linked = drawNetwork();

      // while they're scattered stars, each one twinkles on its own rhythm; it fades out as they organize
      const twinkle = reduce ? 0 : 0.45 * (1 - clamp01(s * 2));
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        const on = linked.has(i);
        let alpha = twinkle && !on ? 1 - twinkle * (0.5 + 0.5 * Math.sin(t * (1.2 + p.seed * 2.8) + p.phase * 4)) : 1;
        // behind the opening copy a dot dims: barely there on a phone, still clearly visible on desktop's plate
        if (copyBox && p.x > copyBox.x0 && p.x < copyBox.x1 && p.y > copyBox.y0 && p.y < copyBox.y1) {
          const floor = mobile ? 0.08 : 0.75;
          alpha *= floor + (1 - floor) * clamp01(s * 2);
        }
        ctx.globalAlpha = alpha;
        ctx.fillStyle = css(on ? mixRgb(frameColors[i], WHITE, 0.65) : frameColors[i]);
        ctx.beginPath();
        ctx.arc(p.x, p.y, on ? p.size + 1.2 : p.size, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      drawLabels(s);
      drawMeteor(t, mapAlpha);
    }

    // hovering wires the points near the cursor into a network: edges to the cursor and between neighbours
    const frameColors: RGB[] = [];
    const WHITE: RGB = [255, 255, 255];
    function drawNetwork() {
      const linked = new Set<number>();
      if (mouse.x < -999) return linked;
      const reach = mobile ? 110 : 170;
      const link = mobile ? 42 : 58;
      // nearest nodes only, so dense shapes don't turn into a solid web
      const cand: [number, number][] = [];
      for (let i = 0; i < particles.length; i += 3) {
        const p = particles[i];
        const d2 = (p.x - mouse.x) ** 2 + (p.y - mouse.y) ** 2;
        if (d2 < reach * reach) cand.push([d2, i]);
      }
      // nearest-first, thinned evenly so a dense shape gets a web spread across the whole reach
      cand.sort((a, b) => a[0] - b[0]);
      const every = Math.max(1, cand.length / 40);
      const near: number[] = [];
      for (let j = 0; j < cand.length; j += every) near.push(cand[Math.floor(j)][1]);
      ctx.save();
      ctx.lineWidth = 1;
      for (let a = 0; a < near.length; a++) {
        const pa = particles[near[a]];
        const fa = 1 - Math.hypot(pa.x - mouse.x, pa.y - mouse.y) / reach;
        let edges = 0;
        linked.add(near[a]);
        for (let b = a + 1; b < near.length && edges < 3; b++) {
          const pb = particles[near[b]];
          const d = Math.hypot(pa.x - pb.x, pa.y - pb.y);
          if (d > link) continue;
          edges++;
          ctx.strokeStyle = `rgba(52,211,153,${(0.95 * fa * (1 - d / link)).toFixed(3)})`;
          ctx.beginPath();
          ctx.moveTo(pa.x, pa.y);
          ctx.lineTo(pb.x, pb.y);
          ctx.stroke();
        }
        // the nearest points also connect straight to the cursor, the hub
        if (fa > 0.35) {
          ctx.strokeStyle = `rgba(167,243,208,${(0.45 * fa).toFixed(3)})`;
          ctx.beginPath();
          ctx.moveTo(mouse.x, mouse.y);
          ctx.lineTo(pa.x, pa.y);
          ctx.stroke();
        }
      }
      ctx.restore();
      return linked;
    }

    // now and then a shooting star crosses the open sky (never through a constellation)
    let meteor: { x: number; y: number; dx: number; dy: number; t0: number } | null = null;
    let nextMeteor = -1;
    const METEOR_LIFE = 0.9, METEOR_RUN = 380, METEOR_TAIL = 120;

    function drawMeteor(t: number, alpha: number) {
      if (reduce || forced !== null) return;
      if (nextMeteor < 0) nextMeteor = t + 4 + Math.random() * 3; // the first one, a few seconds in
      if (!meteor && t >= nextMeteor && alpha > 0.5) {
        for (let tries = 0; tries < 12 && !meteor; tries++) {
          const ang = ((18 + Math.random() * 16) * Math.PI) / 180;
          const dir = Math.random() < 0.5 ? -1 : 1;
          const c = { x: W * (0.15 + Math.random() * 0.7), y: H * (0.06 + Math.random() * 0.35), dx: Math.cos(ang) * dir, dy: Math.sin(ang), t0: t };
          let ok = true;
          for (let d = -METEOR_TAIL; d <= METEOR_RUN && ok; d += 8) ok = !hit(clear, c.x + c.dx * d, c.y + c.dy * d);
          if (ok) meteor = c;
        }
        nextMeteor = t + (mobile ? 10 : 6) + Math.random() * 5; // desktop's wider sky sees them more often
      }
      if (!meteor) return;
      const p = (t - meteor.t0) / METEOR_LIFE;
      if (p >= 1) {
        meteor = null;
        return;
      }
      const run = METEOR_RUN * (1 - (1 - p) * (1 - p)); // fast start, easing out
      const hx = meteor.x + meteor.dx * run, hy = meteor.y + meteor.dy * run;
      const tail = METEOR_TAIL * Math.sin(Math.PI * Math.min(1, p * 1.4));
      const a = Math.sin(Math.PI * p) * alpha;
      const g = ctx.createLinearGradient(hx, hy, hx - meteor.dx * tail, hy - meteor.dy * tail);
      g.addColorStop(0, `rgba(236,253,245,${(0.95 * a).toFixed(3)})`);
      g.addColorStop(1, "rgba(236,253,245,0)");
      ctx.save();
      ctx.strokeStyle = g;
      ctx.lineWidth = 1.6;
      ctx.lineCap = "round";
      ctx.beginPath();
      ctx.moveTo(hx, hy);
      ctx.lineTo(hx - meteor.dx * tail, hy - meteor.dy * tail);
      ctx.stroke();
      ctx.fillStyle = `rgba(236,253,245,${a.toFixed(3)})`;
      ctx.beginPath();
      ctx.arc(hx, hy, 1.6, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    function drawLabels(s: number) {
      // industry labels fade in around the cluster stage only
      const alpha = clamp01(1 - Math.abs(s - 1) * 2.2);
      if (alpha <= 0) return;
      const st = stage();
      const cols = mobile ? 2 : 4;
      const cw = st.w / cols;
      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.font = `600 ${mobile ? 11 : 13}px "Inter Variable", system-ui, sans-serif`;
      ctx.textAlign = "center";
      GROUPS.forEach((g, i) => {
        const cx = st.x + cw * ((i % cols) + 0.5);
        ctx.fillStyle = GROUP_COLORS[i];
        ctx.fillText(g.toUpperCase(), cx, labelY[i] + (mobile ? 27 : 30));
      });
      ctx.restore();
    }

    canvas.addEventListener("pointermove", (e) => {
      if (e.pointerType === "touch") return;
      const r = canvas.getBoundingClientRect();
      mouse.x = e.clientX - r.left;
      mouse.y = e.clientY - r.top;
    }, { signal });
    canvas.addEventListener("pointerleave", () => { mouse.x = mouse.y = -9999; }, { signal });

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(build, 150);
    }, { signal });
    // webviews don't always fire window resize when they're first shown
    const ro = new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(build, 150);
    });
    ro.observe(canvas);
    signal.addEventListener("abort", () => ro.disconnect());

    // Touch screens: each swipe moves exactly one step, however hard the fling.
    // Inside the hero the page doesn't scroll natively; a swipe animates to the
    // next (or previous) step, and a swipe past the last step leaves the hero.
    if (window.matchMedia("(pointer: coarse)").matches) {
      const stepY = (i: number) => {
        const top = section.getBoundingClientRect().top + window.scrollY;
        if (i >= STAGES) return top + section.offsetHeight; // the content after the hero
        return top + ((section.offsetHeight - window.innerHeight) * Math.max(0, i)) / (STAGES - 1);
      };
      const nearestStep = () => {
        let best = 0;
        for (let i = 1; i <= STAGES; i++) if (Math.abs(stepY(i) - window.scrollY) < Math.abs(stepY(best) - window.scrollY)) best = i;
        return best;
      };
      let startY = 0, owned = false, current = 0, moving = 0;
      window.addEventListener("touchstart", (e) => {
        startY = e.touches[0].clientY;
        // only take over while the page is on (or between) the hero's steps
        // (touches on the nav or an open menu keep their normal scrolling)
        owned = e.touches.length === 1 && section.contains(e.target as Node) && window.scrollY <= stepY(STAGES - 1) + 2;
        if (owned && performance.now() > moving) current = nearestStep();
      }, { passive: true, signal });
      window.addEventListener("touchmove", (e) => {
        if (owned && e.cancelable) e.preventDefault();
      }, { passive: false, signal });
      window.addEventListener("touchend", (e) => {
        if (!owned) return;
        owned = false;
        const dy = startY - e.changedTouches[0].clientY;
        if (Math.abs(dy) < 24) return; // a tap, not a swipe
        current = Math.max(0, Math.min(STAGES, current + (dy > 0 ? 1 : -1)));
        moving = performance.now() + 700; // swipes during the glide keep counting from its target
        window.scrollTo({ top: stepY(current), behavior: reduce ? "auto" : "smooth" });
      }, { passive: true, signal });
    }

    build();
    // fonts change the word's shape; rebuild once they're ready
    document.fonts?.load('900 100px "Inter Variable"').then(() => {
      if (alive && builtWidth > 0) targets[3] = wordTargets();
    });
    requestAnimationFrame(frame);
  }

  init();
  document.addEventListener("astro:after-swap", init);
</script>
