---
import { Icon } from "astro-icon/components";

import Button from "@/components/button/Button.astro";

// Scroll-driven hero: scattered data points sort, structure, and finally spell "confidence."
const steps = [
  { tag: "02 / Organized", title: "Sorted into what they are.", body: "Financial services, retail, food service, home improvement: every tidbit finds its home." },
  { tag: "03 / Structured", title: "Modeled into a pipeline.", body: "Clean, connected data that shows where the business is heading." },
  { tag: "04 / Trusted", title: "Turned into confidence.", body: "So the people making the call can act on it." },
];
---

<section id="converge" class="converge" aria-label="Hero section">
  <div class="converge__sticky">
    <canvas id="converge-canvas" aria-hidden="true"></canvas>

    <div class="converge__captions">
      <div class="converge__step converge__step--hero" data-step="0">
        <p class="converge__tag">01 / Fragmented</p>
        <h1 class="leading-tighter font-heading mb-4 text-4xl font-semibold text-white md:text-5xl xl:text-6xl">
          Ten years.<br />Four industries.
        </h1>
        <p class="mb-8 text-lg text-white/75 md:text-xl">
          Millions of scattered data points, none of them talking to each other.
          <span style="color: #34d399; font-weight: 600;">I connect the dots.</span>
        </p>
        <div class="flex flex-wrap gap-4">
          <Button type="button" href="/Rotunno_Resume.pdf" download="Rotunno_Resume.pdf" variant="primary" class="md:text-lg" aria-label="Download CV">
            <div class="flex items-center gap-2">
              <span>Download CV</span>
              <Icon name="tabler/download" aria-hidden="true" class="size-5" />
            </div>
          </Button>
          <a
            href="https://calendly.com/chrisrotunno-_my2/30min"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Schedule a Call"
            class="inline-flex items-center gap-2 px-4 py-2 text-white/70 transition-colors hover:text-white md:text-lg"
          >
            <Icon name="tabler/calendar" aria-hidden="true" class="size-5" />
            <span>Schedule a Call</span>
          </a>
        </div>
      </div>
      {
        steps.map((s, i) => (
          <div class="converge__step" data-step={i + 1}>
            <p class="converge__tag">{s.tag}</p>
            <h2 class="converge__title">{s.title}</h2>
            <p class="converge__body">{s.body}</p>
          </div>
        ))
      }
    </div>

    <div class="converge__rail" aria-hidden="true">
      {[0, 1, 2, 3].map((i) => <span data-dot={i} />)}
    </div>

    <div class="converge__hint">
      <p class="converge__hint-action" aria-hidden="true">Scroll <span>↓</span><span class="converge__hint-cursor"> &nbsp;·&nbsp; move your cursor to connect the dots</span></p>
      <p class="converge__hint-note">Illustration only: every dot here is fictional.</p>
    </div>
  </div>
</section>

<style>
  .converge {
    position: relative;
    height: 380vh;
    background: radial-gradient(ellipse at 50% 0%, #11294a 0%, #071223 55%, #050b16 100%);
    color: #e6f1ff;
  }
  .converge__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }
  #converge-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: crosshair;
  }
  .converge__captions {
    position: absolute;
    left: clamp(16px, 5vw, 72px);
    top: 50%;
    transform: translateY(-50%);
    width: min(520px, 40vw);
    pointer-events: none;
  }
  .converge__step {
    position: absolute;
    width: 100%;
    top: 0;
    transform: translateY(-50%);
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .converge__step.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  .converge__tag {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #34d399;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .converge__title {
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.15;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .converge__body {
    color: #9fb3cc;
    font-size: 1rem;
    line-height: 1.55;
  }
  .converge__rail {
    position: absolute;
    right: clamp(16px, 3vw, 40px);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .converge__rail span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #2a3d57;
    transition: background 0.3s, transform 0.3s;
  }
  .converge__rail span.is-active {
    background: #34d399;
    transform: scale(1.5);
  }
  .converge__hint {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.8rem;
    color: #7f93ad;
    text-align: center;
    white-space: nowrap;
  }
  @media (hover: none), (pointer: coarse) {
    .converge__hint-cursor {
      display: none;
    }
  }
  .converge__hint-action {
    transition: opacity 0.4s;
  }
  .converge__hint-note {
    margin-top: 4px;
    font-size: 0.7rem;
    color: #8aa0bb;
    font-style: italic;
  }
  .converge__hint-action > span:first-child {
    display: inline-block;
    animation: converge-bob 1.6s ease-in-out infinite;
  }
  @keyframes converge-bob {
    50% { transform: translateY(4px); }
  }

  @media (max-width: 767px) {
    .converge__captions {
      top: auto;
      bottom: 72px;
      transform: none;
      width: auto;
      right: 16px;
      left: 16px;
      height: 150px;
    }
    .converge__step {
      transform: none;
      bottom: 0;
      top: auto;
    }
    .converge__hint {
      bottom: 20px;
      font-size: 0.7rem;
    }
  }
</style>


<script>
  type Pt = { x: number; y: number };
  type Particle = {
    x: number; y: number; // rendered position
    seed: number; // 0..1, staggers each particle's transition
    phase: number; // drift phase for the chaos stage
    group: number; // industry cluster
    size: number;
  };

  const GROUPS = ["Financial Services", "Retail", "Food Service", "Home Improvement"];
  const GROUP_COLORS = ["#38bdf8", "#a78bfa", "#f59e0b", "#34d399"];
  const CHAOS_COLORS = ["#4b5d78", "#6b7f99", "#8aa0bb", "#3b4a60", "#5c6f8a"];
  const STAGES = 4;

  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const clamp01 = (t: number) => Math.min(1, Math.max(0, t));
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  function hexToRgb(hex: string) {
    const n = parseInt(hex.slice(1), 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }
  type RGB = number[];
  const mixRgb = (A: RGB, B: RGB, t: number): RGB => [lerp(A[0], B[0], t), lerp(A[1], B[1], t), lerp(A[2], B[2], t)];
  const css = (c: RGB) => `rgb(${c[0] | 0},${c[1] | 0},${c[2] | 0})`;

  function init() {
    const section = document.getElementById("converge");
    const canvas = document.getElementById("converge-canvas") as HTMLCanvasElement | null;
    if (!section || !canvas) return;
    const ctx = canvas.getContext("2d")!;
    const steps = [...section.querySelectorAll<HTMLElement>("[data-step]")];
    const dots = [...section.querySelectorAll<HTMLElement>("[data-dot]")];
    const hint = section.querySelector<HTMLElement>(".converge__hint-action");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // view transitions keep this script alive across pages; stop when the hero leaves
    let alive = true;
    const ac = new AbortController();
    const signal = ac.signal;
    document.addEventListener("astro:before-swap", () => { alive = false; ac.abort(); }, { once: true });

    let W = 0, H = 0, dpr = 1, mobile = false;
    let particles: Particle[] = [];
    let targets: Pt[][] = []; // [stage][particle]
    let colors: RGB[][] = [];
    const q = new URLSearchParams(location.search);
    const mouse = { x: Number(q.get("mx") ?? -9999), y: Number(q.get("my") ?? -9999) };

    // the area the shapes are drawn in, leaving room for captions
    function stage() {
      if (mobile) return { x: 16, y: H * 0.12, w: W - 32, h: H * 0.5 };
      const left = Math.min(W * 0.42, 560);
      return { x: left, y: H * 0.14, w: W - left - 80, h: H * 0.72 };
    }

    function chaosTargets(): Pt[] {
      return particles.map(() => ({ x: Math.random() * W, y: Math.random() * H }));
    }

    function clusterTargets(): Pt[] {
      const s = stage();
      const cols = mobile ? 2 : 4;
      const rows = mobile ? 2 : 1;
      const cw = s.w / cols, ch = s.h / rows;
      const r = Math.min(cw, ch) * 0.32;
      return particles.map((p) => {
        const cx = s.x + cw * ((p.group % cols) + 0.5);
        const cy = s.y + ch * (Math.floor(p.group / cols) + 0.45);
        // sunflower spiral packing: dense, round, organic
        const k = Math.random();
        const a = p.seed * 2399.96;
        return { x: cx + Math.cos(a) * r * Math.sqrt(k), y: cy + Math.sin(a) * r * Math.sqrt(k) };
      });
    }

    function chartTargets(): Pt[] {
      const s = stage();
      const bars = mobile ? 8 : 12;
      const gap = s.w / bars;
      const bw = gap * 0.6;
      const heights = Array.from({ length: bars }, (_, i) => 0.16 + 0.84 * Math.pow((i + 1) / bars, 1.4) - (i % 4 === 2 ? 0.06 : 0));
      // pick a dot spacing so the bars hold every particle on a tidy grid
      const area = heights.reduce((a, h) => a + bw * h * s.h * 0.9, 0);
      const sp = Math.sqrt(area / particles.length);
      const base = s.y + s.h * 0.95;
      const out: Pt[] = [];
      for (let b = 0; b < bars && out.length < particles.length; b++) {
        const cols = Math.max(1, Math.floor(bw / sp));
        const x0 = s.x + gap * b + (gap - (cols - 1) * sp) / 2;
        const rows = Math.round((heights[b] * s.h * 0.9) / sp);
        for (let r = 0; r < rows; r++)
          for (let c = 0; c < cols; c++) out.push({ x: x0 + c * sp, y: base - r * sp });
      }
      // leftovers stack on top of the tallest bar's column
      while (out.length < particles.length) out.push(out[out.length - 1 - Math.floor(Math.random() * 40)]);
      out.length = particles.length;
      return shuffle(out);
    }

    function wordTargets(): Pt[] {
      const s = stage();
      const off = document.createElement("canvas");
      const ow = Math.floor(s.w), oh = Math.floor(s.h);
      off.width = ow; off.height = oh;
      const o = off.getContext("2d")!;
      const word = mobile ? "trusted." : "confidence.";
      let size = oh * 0.5;
      o.font = `900 ${size}px "Inter Variable", system-ui, sans-serif`;
      size = Math.min(size, (size * ow * 0.96) / o.measureText(word).width);
      o.font = `900 ${size}px "Inter Variable", system-ui, sans-serif`;
      o.textAlign = "center";
      o.textBaseline = "middle";
      o.fillStyle = "#fff";
      o.fillText(word, ow / 2, oh / 2);
      const data = o.getImageData(0, 0, ow, oh).data;
      let filled = 0;
      for (let i = 3; i < data.length; i += 4) if (data[i] > 140) filled++;
      // one grid point per particle, so the letters come out crisp
      const sp = Math.max(2, Math.sqrt(filled / particles.length));
      const pts: Pt[] = [];
      for (let y = sp / 2; y < oh; y += sp)
        for (let x = sp / 2; x < ow; x += sp)
          if (data[(Math.floor(y) * ow + Math.floor(x)) * 4 + 3] > 140) pts.push({ x: s.x + x, y: s.y + y });
      shuffle(pts);
      return particles.map((_, i) => pts[i % pts.length]);
    }

    function shuffle<T>(a: T[]) {
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    let builtWidth = -1;
    function build() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = canvas!.clientWidth;
      H = canvas!.clientHeight;
      mobile = W < 768;
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // a height-only resize (phone address bar sliding) keeps every point where it is
      if (W === builtWidth) return;
      builtWidth = W;

      const count = mobile ? 800 : 2400;
      if (particles.length !== count) {
        particles = Array.from({ length: count }, (_, i) => ({
          x: 0,
          y: 0,
          seed: Math.random(),
          phase: Math.random() * Math.PI * 2,
          group: i % GROUPS.length,
          size: 1.1 + Math.random() * 1.1,
        }));
      }
      targets = [chaosTargets(), clusterTargets(), chartTargets(), wordTargets()];
      const s = stage();
      const lo = hexToRgb("#0ea5e9"), hi = hexToRgb("#7dd3fc");
      colors = [
        particles.map(() => hexToRgb(CHAOS_COLORS[Math.floor(Math.random() * CHAOS_COLORS.length)])),
        particles.map((p) => hexToRgb(GROUP_COLORS[p.group])),
        targets[2].map((t) => mixRgb(lo, hi, clamp01((s.y + s.h - t.y) / s.h))),
        particles.map(() => hexToRgb(Math.random() < 0.85 ? "#34d399" : "#a7f3d0")),
      ];
      // start every point on its scattered spot, so nothing streaks across the screen on load
      particles.forEach((p, i) => {
        p.x = targets[0][i].x;
        p.y = targets[0][i].y;
      });
    }

    const forced = new URLSearchParams(location.search).get("p");
    function progress() {
      if (forced !== null) return clamp01(parseFloat(forced));
      const r = section!.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      return clamp01(-r.top / span);
    }

    let lastActive = -1;
    function frame(time: number) {
      if (section!.getBoundingClientRect().bottom <= 0) {
        if (alive) requestAnimationFrame(frame);
        return;
      }
      const s = progress() * (STAGES - 1);
      const k = Math.min(STAGES - 2, Math.floor(s));
      const local = s - k;
      const active = Math.round(s);

      if (active !== lastActive) {
        steps.forEach((el, i) => el.classList.toggle("is-active", i === active));
        dots.forEach((el, i) => el.classList.toggle("is-active", i === active));
        lastActive = active;
      }
      if (hint) hint.style.opacity = s < 0.15 ? "1" : "0";

      ctx.clearRect(0, 0, W, H);
      const t = time / 1000;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        // stagger: each particle starts and finishes its move at a slightly different moment
        const lt = ease(clamp01((local - p.seed * 0.35) / 0.65));
        const a = targets[k][i], b = targets[k + 1][i];
        let tx = lerp(a.x, b.x, lt);
        let ty = lerp(a.y, b.y, lt);

        // chaos drift fades out as structure takes over
        const drift = reduce ? 0 : (1 - clamp01(s)) * 14 + 0.3;
        tx += Math.sin(t * 0.6 + p.phase) * drift;
        ty += Math.cos(t * 0.5 + p.phase * 1.3) * drift;

        // cursor clears a small pocket; the spring brings points back
        const dx = tx - mouse.x, dy = ty - mouse.y;
        const d2 = dx * dx + dy * dy;
        const R = mobile ? 30 : 46;
        if (d2 < R * R) {
          const d = Math.sqrt(d2) || 1;
          const f = (1 - d / R) * R * 0.9;
          tx += (dx / d) * f;
          ty += (dy / d) * f;
        }

        const spring = forced !== null || reduce ? 1 : 0.14;
        p.x += (tx - p.x) * spring;
        p.y += (ty - p.y) * spring;

        frameColors[i] = mixRgb(colors[k][i], colors[k + 1][i], lt);
      }

      const linked = drawNetwork();

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        const on = linked.has(i);
        ctx.fillStyle = css(on ? mixRgb(frameColors[i], WHITE, 0.65) : frameColors[i]);
        ctx.beginPath();
        ctx.arc(p.x, p.y, on ? p.size + 1.2 : p.size, 0, Math.PI * 2);
        ctx.fill();
      }

      drawLabels(s);
      if (alive) requestAnimationFrame(frame);
    }

    // hovering wires the points near the cursor into a network: edges to the cursor and between neighbours
    const frameColors: RGB[] = [];
    const WHITE: RGB = [255, 255, 255];
    function drawNetwork() {
      const linked = new Set<number>();
      if (mouse.x < -999) return linked;
      const reach = mobile ? 110 : 170;
      const link = mobile ? 42 : 58;
      // nearest nodes only, so dense shapes don't turn into a solid web
      const cand: [number, number][] = [];
      for (let i = 0; i < particles.length; i += 3) {
        const p = particles[i];
        const d2 = (p.x - mouse.x) ** 2 + (p.y - mouse.y) ** 2;
        if (d2 < reach * reach) cand.push([d2, i]);
      }
      // nearest-first, thinned evenly so a dense shape gets a web spread across the whole reach
      cand.sort((a, b) => a[0] - b[0]);
      const every = Math.max(1, cand.length / 40);
      const near: number[] = [];
      for (let j = 0; j < cand.length; j += every) near.push(cand[Math.floor(j)][1]);
      ctx.save();
      ctx.lineWidth = 1;
      for (let a = 0; a < near.length; a++) {
        const pa = particles[near[a]];
        const fa = 1 - Math.hypot(pa.x - mouse.x, pa.y - mouse.y) / reach;
        let edges = 0;
        linked.add(near[a]);
        for (let b = a + 1; b < near.length && edges < 3; b++) {
          const pb = particles[near[b]];
          const d = Math.hypot(pa.x - pb.x, pa.y - pb.y);
          if (d > link) continue;
          edges++;
          ctx.strokeStyle = `rgba(52,211,153,${(0.95 * fa * (1 - d / link)).toFixed(3)})`;
          ctx.beginPath();
          ctx.moveTo(pa.x, pa.y);
          ctx.lineTo(pb.x, pb.y);
          ctx.stroke();
        }
        // the nearest points also connect straight to the cursor, the hub
        if (fa > 0.35) {
          ctx.strokeStyle = `rgba(167,243,208,${(0.45 * fa).toFixed(3)})`;
          ctx.beginPath();
          ctx.moveTo(mouse.x, mouse.y);
          ctx.lineTo(pa.x, pa.y);
          ctx.stroke();
        }
      }
      ctx.restore();
      return linked;
    }

    function drawLabels(s: number) {
      // industry labels fade in around the cluster stage only
      const alpha = clamp01(1 - Math.abs(s - 1) * 2.2);
      if (alpha <= 0) return;
      const st = stage();
      const cols = mobile ? 2 : 4, rows = mobile ? 2 : 1;
      const cw = st.w / cols, ch = st.h / rows;
      const r = Math.min(cw, ch) * 0.32;
      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.font = `600 ${mobile ? 11 : 13}px "Inter Variable", system-ui, sans-serif`;
      ctx.textAlign = "center";
      GROUPS.forEach((g, i) => {
        const cx = st.x + cw * ((i % cols) + 0.5);
        const cy = st.y + ch * (Math.floor(i / cols) + 0.45);
        ctx.fillStyle = GROUP_COLORS[i];
        ctx.fillText(g.toUpperCase(), cx, cy + r + 26);
      });
      ctx.restore();
    }

    canvas.addEventListener("pointermove", (e) => {
      if (e.pointerType === "touch") return;
      const r = canvas.getBoundingClientRect();
      mouse.x = e.clientX - r.left;
      mouse.y = e.clientY - r.top;
    }, { signal });
    canvas.addEventListener("pointerleave", () => { mouse.x = mouse.y = -9999; }, { signal });

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(build, 150);
    }, { signal });

    build();
    // fonts change the word's shape; rebuild once they're ready
    document.fonts?.load('900 100px "Inter Variable"').then(() => {
      if (alive) targets[3] = wordTargets();
    });
    requestAnimationFrame(frame);
  }

  init();
  document.addEventListener("astro:after-swap", init);
</script>
