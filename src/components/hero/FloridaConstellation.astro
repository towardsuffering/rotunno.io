---
/**
 * Florida drawn in the hero headline's style: the real state outline in a white-to-silver sheen
 * with a soft blue glow, and the Northeast Florida territory shaded green inside it.
 * Outlines are simplified from the traced boundary at build time, so nothing is hand-placed.
 */
import { FLORIDA_PATH, HOME, NE_FLORIDA_PATH } from "./floridaPaths";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

type Pt = [number, number];

// "M x,y L x,y ... Z M ..." into one point list per subpath
function subpaths(d: string): Pt[][] {
  return d
    .split("M")
    .filter((p) => p.trim())
    .map((p) =>
      [...p.replace(/Z/g, "").matchAll(/(-?[\d.]+),(-?[\d.]+)/g)].map((m) => [Number(m[1]), Number(m[2])] as Pt),
    );
}

// Ramer-Douglas-Peucker: keep only the points that carry the shape
function simplify(pts: Pt[], eps: number): Pt[] {
  if (pts.length < 3) return pts;
  const [a, b] = [pts[0], pts[pts.length - 1]];
  let worst = 0;
  let at = 0;
  for (let i = 1; i < pts.length - 1; i++) {
    const [x, y] = pts[i];
    const len = Math.hypot(b[0] - a[0], b[1] - a[1]) || 1;
    const dist = Math.abs((b[1] - a[1]) * x - (b[0] - a[0]) * y + b[0] * a[1] - b[1] * a[0]) / len;
    if (dist > worst) [worst, at] = [dist, i];
  }
  if (worst <= eps) return [a, b];
  return [...simplify(pts.slice(0, at + 1), eps).slice(0, -1), ...simplify(pts.slice(at), eps)];
}

// a closed ring loses its duplicate end point
const ring = (pts: Pt[], eps: number) => {
  const s = simplify(pts, eps);
  return s.length > 2 && s[0][0] === s.at(-1)![0] && s[0][1] === s.at(-1)![1] ? s.slice(0, -1) : s;
};

const outline = subpaths(FLORIDA_PATH);
const home: Pt = [HOME.x, HOME.y];

// the frame includes room for the label east of the state, over the ocean
const VIEWBOX = [28, -20, 306, 214]; // the state spans x 34 to 230, y 0 to 189
// the full (unsimplified) outline, for HeroConverge to keep its dots outside the border
const shape = JSON.stringify({ viewBox: VIEWBOX, rings: outline.map((p) => p.map(([x, y]) => [+x.toFixed(1), +y.toFixed(1)])) });

const poly = (pts: Pt[]) => pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
// a finer outline than a constellation needs, so the coast reads as a drawn map
const smooth = outline.map((p) => ring(p, 0.9)).filter((p) => p.length >= 3);
const neSmooth = subpaths(NE_FLORIDA_PATH).map((p) => ring(p, 0.8))[0];
---

<svg class={className} viewBox={VIEWBOX.join(" ")} data-shape={shape} xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <!-- the headline's treatment: bright white shading down to soft silver -->
    <linearGradient id="fl-silver" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="0.55" stop-color="#eef3fb" />
      <stop offset="1" stop-color="#b9c6da" />
    </linearGradient>
    <linearGradient id="fl-silver-fill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.16" />
      <stop offset="1" stop-color="#b9c6da" stop-opacity="0.05" />
    </linearGradient>
    <radialGradient id="fl-home-glow">
      <stop offset="0" stop-color="#34d399" stop-opacity="0.7" />
      <stop offset="1" stop-color="#34d399" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- the state, drawn like the headline: a silver outline with a faint silver fill and a soft blue glow -->
  <g class="fl-state">
    {smooth.map((p) => <polygon points={poly(p)} />)}
  </g>

  <!-- Northeast Florida, shaded green -->
  <polygon points={poly(neSmooth)} class="fl-ne" />

  <!-- home base -->
  <circle cx={home[0]} cy={home[1]} r="9" fill="url(#fl-home-glow)" class="fl-home-glow" />
  <circle cx={home[0]} cy={home[1]} r="2.2" fill="#ecfdf5" />

  <!-- label, east of the state over the ocean -->
  <g>
    <polyline points={`${home[0] + 6},${home[1] - 6} ${home[0] + 20},${home[1] - 22} ${home[0] + 28},${home[1] - 22}`} fill="none" class="fl-leader" />
    <text x={home[0] + 31} y={home[1] - 24} class="fl-name">NORTHEAST FLORIDA</text>
    <text x={home[0] + 31} y={home[1] - 15} class="fl-sub">home base</text>
  </g>
</svg>

<style>
  svg {
    overflow: visible;
  }
  .fl-state polygon {
    fill: url(#fl-silver-fill);
    stroke: url(#fl-silver);
    stroke-width: 1.3;
    stroke-linejoin: round;
  }
  .fl-state {
    filter: drop-shadow(0 1px 10px rgba(120, 170, 255, 0.28));
  }
  .fl-ne {
    fill: #34d399;
    fill-opacity: 0.16;
    stroke: #34d399;
    stroke-opacity: 0.75;
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .fl-home-glow {
    animation: fl-pulse 2.6s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes fl-pulse {
    0%,
    100% {
      opacity: 0.7;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.25);
    }
  }
  .fl-leader {
    fill: none;
    stroke: #34d399;
    stroke-opacity: 0.5;
    stroke-width: 0.5;
  }
  .fl-name {
    fill: #a7f3d0;
    font: 700 6.5px "Inter Variable", system-ui, sans-serif;
    letter-spacing: 0.18em;
  }
  .fl-sub {
    fill: #8aa0bb;
    font: italic 500 6px "Inter Variable", system-ui, sans-serif;
    letter-spacing: 0.04em;
  }
  @media (prefers-reduced-motion: reduce) {
    .fl-home-glow {
      animation: none;
    }
  }
</style>
