---
import { Icon } from "astro-icon/components";

import Button from "@/components/button/Button.astro";
import FloridaMapSVG from "@/components/hero/FloridaMapSVG.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { useTranslations } from "@/js/translationUtils";

const currLocale = getLocaleFromUrl(Astro.url);
const t = useTranslations(currLocale);
---

<section
  class="relative isolate mx-auto flex w-full items-center overflow-hidden"
  aria-label="Hero section"
>
  <!-- Background: deep navy dark data theme -->
  <div
    class="pointer-events-none absolute inset-0 z-0"
    style="background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 55%, #0f2d4a 100%);"
    aria-hidden="true"
  >
  </div>

  <div
    class="site-container relative flex h-full min-h-full grow flex-col items-center justify-between gap-8 md:flex-row"
  >
    <div id="hero-shapes-trigger" class="max-w-2xl flex-1 pt-30 md:py-44 lg:pb-50">
      <h1
        data-mos-anchor="#hero-shapes-trigger"
        data-mos="fade-right"
        class="leading-tighter font-heading mb-4 text-4xl font-semibold text-white md:text-5xl xl:text-6xl"
      >
        NE Florida's Leading<br /><span style="color: #34d399;">B2C Sales Generator.</span>
      </h1>
      <p
        data-mos-anchor="#hero-shapes-trigger"
        data-mos="fade-right"
        data-mos-delay=".15"
        class="mb-4 text-lg font-semibold text-white/90 md:text-xl"
        style="font-family: var(--font-heading, sans-serif);"
      >
        For Home Improvement Sales. 🏠
      </p>
      <p
        data-mos-anchor="#hero-shapes-trigger"
        data-mos="fade-right"
        data-mos-delay=".2"
        class="mb-8 text-lg text-white/75 md:text-xl"
      >
        I don't just generate leads — I <span style="color: #34d399; font-weight: 600;"
          >orchestrate the intelligence pipeline</span
        >.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button
          type="button"
          href="/Rotunno_Resume.pdf"
          download="Rotunno_Resume.pdf"
          variant="primary"
          class="md:text-lg"
          aria-label="Download CV"
          data-mos-anchor="#hero-shapes-trigger"
          data-mos="fade-right"
          data-mos-delay=".4"
        >
          <div class="flex items-center gap-2">
            <span>Download CV</span>
            <Icon name="tabler/download" aria-hidden="true" class="size-5" />
          </div>
        </Button>
        <a
          href="https://calendly.com/chrisrotunno-_my2/30min"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Schedule a Call"
          data-mos-anchor="#hero-shapes-trigger"
          data-mos="fade-right"
          data-mos-delay=".55"
          class="inline-flex items-center gap-2 px-4 py-2 text-white/70 transition-colors hover:text-white md:text-lg"
        >
          <Icon name="tabler/calendar" aria-hidden="true" class="size-5" />
          <span>Schedule a Call</span>
        </a>
      </div>
    </div>

    <div
      class="xs:h-[360px] mt-auto flex h-[300px] justify-end md:h-[500px] md:pt-20 lg:h-[600px] xl:h-[700px]"
    >
      <FloridaMapSVG />
    </div>
  </div>
</section>
