---
import Button from "@/components/button/Button.astro";
import DataDashboardSVG from "@/components/hero/DataDashboardSVG.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getLocalizedRoute, useTranslations } from "@/js/translationUtils";

const currLocale = getLocaleFromUrl(Astro.url);
const t = useTranslations(currLocale);
---

<section
  class="relative isolate mx-auto flex w-full items-center overflow-hidden"
  aria-label="Hero section"
>
  <!-- Background: deep navy dark data theme -->
  <div
    class="pointer-events-none absolute inset-0 z-0"
    style="background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 55%, #0f2d4a 100%);"
    aria-hidden="true"
  >
  </div>

  <div
    class="site-container relative flex h-full min-h-full grow flex-col items-center justify-between gap-8 md:flex-row"
  >
    <div id="hero-shapes-trigger" class="max-w-2xl flex-1 pt-30 md:py-44 lg:pb-50">
      <h1
        data-mos-anchor="#hero-shapes-trigger"
        data-mos="fade-right"
        class="leading-tighter font-heading mb-4 text-4xl font-semibold text-white md:text-5xl xl:text-6xl"
      >
        Proven Impact.<br /><span style="color: #34d399;">Everywhere I've Worked.</span>
      </h1>
      <p
        data-mos-anchor="#hero-shapes-trigger"
        data-mos="fade-right"
        data-mos-delay=".2"
        class="mb-8 text-lg text-white/75 md:text-xl"
      >
        $50M+ in sales driven. 100K+ customers served. 80% cut from data costs. Five years in
        analytics, five in retail, five in restaurants, a year in home improvement — different
        rooms, same result: I make things measurably better. <span
          style="color: #38bdf8; font-weight: 600;"
          >SQL, NoSQL, Python, JavaScript, Tableau, Spark, Docker, AWS</span
        > — end to end.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button
          type="button"
          href={getLocalizedRoute(currLocale, `/blog`)}
          variant="primary"
          class="md:text-lg"
          aria-label="Pick My Brain"
          data-mos-anchor="#hero-shapes-trigger"
          data-mos="fade-right"
          data-mos-delay=".4"
        >
          Pick My Brain
        </Button>
        <Button
          type="button"
          href="https://calendly.com/chrisrotunno-_my2/30min"
          target="_blank"
          rel="noopener noreferrer"
          variant="ghost"
          class="border border-white/30 text-white hover:bg-white/10 md:text-lg"
          aria-label="Pencil Me In"
          data-mos-anchor="#hero-shapes-trigger"
          data-mos="fade-right"
          data-mos-delay=".55"
        >
          Pencil Me In
        </Button>
      </div>
    </div>

    <div
      class="xs:h-[360px] mt-auto flex h-[300px] justify-end md:h-[500px] md:pt-20 lg:h-[600px] xl:h-[700px]"
    >
      <DataDashboardSVG />
    </div>
  </div>
</section>
