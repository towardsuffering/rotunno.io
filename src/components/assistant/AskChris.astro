---
/**
 * Floating "Ask about Chris" chat on the homepage. Talks to netlify/functions/chat.mts,
 * which relays to the model on Chris's PC. Nothing is fetched until a visitor opens it.
 */
import { ASSISTANT_MAX_CHARS, ASSISTANT_MAX_TURNS, ASSISTANT_SUGGESTIONS } from "@/config/assistant";
---

<div class="ask not-content" data-ask data-max-turns={ASSISTANT_MAX_TURNS} data-suggestions={JSON.stringify(ASSISTANT_SUGGESTIONS)}>
  <section class="ask__panel" id="ask-panel" role="dialog" aria-label="Ask about Chris" hidden data-ask-panel>
    <header class="flex items-start justify-between gap-3 border-b px-4 py-3">
      <div>
        <h2 class="font-heading text-base font-semibold">Ask about Chris</h2>
        <p class="text-muted-foreground flex items-center gap-1.5 text-xs">
          <span class="ask__dot" data-ask-dot></span>
          <span data-ask-status>Checking...</span>
        </p>
      </div>
      <button type="button" class="ask__icon" aria-label="Close" data-ask-close>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
          <path d="M18 6l-12 12 M6 6l12 12" />
        </svg>
      </button>
    </header>

    <ol class="ask__log" aria-live="polite" data-ask-log>
      <li class="ask__msg ask__msg--bot">
        Hi! I can answer questions about Chris's work, skills, and what he's looking for. Answers come from an open-source model running on his own PC.
      </li>
    </ol>

    <div class="flex flex-wrap gap-2 px-4 pb-3" data-ask-suggestions>
      {
        ASSISTANT_SUGGESTIONS.slice(0, 3).map((q) => (
          <button type="button" class="ask__chip">
            {q}
          </button>
        ))
      }
    </div>

    <form class="flex items-end gap-2 border-t p-3" data-ask-form>
      <label for="ask-input" class="sr-only">Your question</label>
      <textarea id="ask-input" rows="1" maxlength={ASSISTANT_MAX_CHARS} placeholder="Ask a question..." class="ask__input" data-ask-input></textarea>
      <button type="submit" class="ask__send" aria-label="Send" data-ask-send>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
          <path d="M10 14l11 -11 M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5" />
        </svg>
      </button>
    </form>
  </section>

  <button type="button" class="ask__launcher" aria-expanded="false" aria-controls="ask-panel" data-ask-toggle>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
      <path d="M8 9h8 M8 13h6 M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z" />
    </svg>
    <span>Ask about Chris</span>
  </button>
</div>

<style>
  .ask {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
  }
  .ask__launcher {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    padding: 0.7rem 1.1rem;
    background: var(--color-primary);
    color: var(--color-primary-foreground);
    font-size: 0.875rem;
    font-weight: 600;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
    transition: transform 0.15s ease;
  }
  .ask__launcher:hover {
    transform: translateY(-1px);
  }
  .ask__panel {
    display: flex;
    flex-direction: column;
    width: min(24rem, calc(100vw - 2rem));
    height: min(32rem, calc(100dvh - 6rem));
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-card);
    color: var(--color-card-foreground);
    box-shadow: 0 16px 48px rgb(0 0 0 / 0.25);
    overflow: hidden;
  }
  .ask__panel[hidden] {
    display: none;
  }
  .ask__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-muted-foreground);
  }
  .ask__dot[data-state="online"] {
    background: oklch(0.7 0.17 150);
  }
  .ask__dot[data-state="offline"] {
    background: oklch(0.65 0.2 25);
  }
  .ask__icon {
    display: inline-flex;
    padding: 0.35rem;
    border-radius: 999px;
    color: var(--color-muted-foreground);
  }
  .ask__icon:hover {
    color: var(--color-foreground);
  }
  .ask__log {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem;
    overflow-y: auto;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .ask :global(.ask__msg) {
    max-width: 88%;
    padding: 0.55rem 0.8rem;
    border-radius: 0.9rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .ask :global(.ask__msg--bot) {
    align-self: flex-start;
    background: var(--color-muted);
  }
  .ask :global(.ask__msg--user) {
    align-self: flex-end;
    background: var(--color-primary);
    color: var(--color-primary-foreground);
  }
  .ask :global(.ask__msg--error) {
    align-self: flex-start;
    color: var(--color-muted-foreground);
    font-style: italic;
  }
  .ask :global(.ask__msg--typing::after) {
    content: "...";
    animation: blink 1s steps(2) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }
  .ask :global(.ask__chip) {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    font-size: 0.75rem;
    transition: border-color 0.15s ease;
  }
  .ask :global(.ask__chip:hover) {
    border-color: var(--color-primary);
  }
  .ask__input {
    flex: 1;
    resize: none;
    max-height: 7rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-background);
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
  }
  .ask__send {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--color-primary);
    color: var(--color-primary-foreground);
  }
  .ask__send:disabled {
    opacity: 0.5;
  }
  @media (max-width: 480px) {
    .ask__launcher span {
      display: none;
    }
  }
</style>

<script>
  // the config module holds the system prompt, so the limit and suggestions come in as data attributes instead of an import
  const API = "/api/chat";

  type Message = { role: "user" | "assistant"; content: string };

  function init() {
    const root = document.querySelector<HTMLElement>("[data-ask]");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";

    const panel = root.querySelector<HTMLElement>("[data-ask-panel]")!;
    const toggle = root.querySelector<HTMLButtonElement>("[data-ask-toggle]")!;
    const log = root.querySelector<HTMLOListElement>("[data-ask-log]")!;
    const form = root.querySelector<HTMLFormElement>("[data-ask-form]")!;
    const input = root.querySelector<HTMLTextAreaElement>("[data-ask-input]")!;
    const send = root.querySelector<HTMLButtonElement>("[data-ask-send]")!;
    const dot = root.querySelector<HTMLElement>("[data-ask-dot]")!;
    const status = root.querySelector<HTMLElement>("[data-ask-status]")!;
    const suggestions = root.querySelector<HTMLElement>("[data-ask-suggestions]")!;

    const maxTurns = Number(root.dataset.maxTurns) || 12;
    const pool: string[] = JSON.parse(root.dataset.suggestions || "[]");
    const history: Message[] = [];
    const asked = new Set<string>();
    let busy = false;
    let checked = false;
    let round = 0; // ignores follow-ups that arrive after a newer question

    function setStatus(online: boolean) {
      dot.dataset.state = online ? "online" : "offline";
      status.textContent = online ? "Online" : "Offline: Chris's PC is asleep. Try again later.";
    }

    async function checkStatus() {
      try {
        const r = await fetch(API);
        setStatus(Boolean((await r.json()).online));
      } catch {
        setStatus(false);
      }
    }

    function open(show: boolean) {
      panel.hidden = !show;
      toggle.setAttribute("aria-expanded", String(show));
      if (show) {
        input.focus();
        if (!checked) {
          checked = true;
          checkStatus();
        }
      }
    }

    function addMessage(kind: "user" | "bot" | "error", text: string) {
      const li = document.createElement("li");
      li.className = `ask__msg ask__msg--${kind}`;
      li.textContent = text;
      log.append(li);
      log.scrollTop = log.scrollHeight;
      return li;
    }

    function showSuggestions(list: string[]) {
      suggestions.replaceChildren(
        ...list.map((q) => {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "ask__chip";
          b.textContent = q;
          return b;
        }),
      );
      suggestions.hidden = list.length === 0;
      log.scrollTop = log.scrollHeight;
    }

    // after each answer, offer three next questions: the model's, or unasked ones from the pool
    async function suggestNext() {
      const mine = ++round;
      const fallback = pool.filter((q) => !asked.has(q.toLowerCase())).slice(0, 3);
      let list: string[] = [];
      try {
        const r = await fetch(API, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ mode: "followups", messages: history.slice(-maxTurns) }),
        });
        list = ((await r.json()) as { followups?: string[] }).followups ?? [];
      } catch {
        // fall back to the pool
      }
      if (mine === round && !busy) showSuggestions(list.length ? list : fallback);
    }

    async function ask(question: string) {
      if (busy || question.trim().length < 2) return;
      busy = true;
      round++;
      send.disabled = true;
      suggestions.hidden = true;
      asked.add(question.trim().toLowerCase());
      addMessage("user", question);
      history.push({ role: "user", content: question });

      const reply = addMessage("bot", "");
      reply.classList.add("ask__msg--typing");
      try {
        const r = await fetch(API, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ messages: history.slice(-maxTurns) }),
        });
        if (!r.ok || !r.body) {
          const err = (await r.json().catch(() => ({}))) as { error?: string };
          throw new Error(err.error ?? "Something went wrong.");
        }
        setStatus(true);
        const reader = r.body.getReader();
        const decoder = new TextDecoder();
        let text = "";
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          text += decoder.decode(value, { stream: true });
          reply.textContent = text;
          log.scrollTop = log.scrollHeight;
        }
        reply.classList.remove("ask__msg--typing");
        if (!text.trim()) throw new Error("No answer came back. Try rephrasing.");
        history.push({ role: "assistant", content: text });
        busy = false;
        suggestNext();
      } catch (e) {
        reply.remove();
        history.pop(); // drop the unanswered question so a retry starts clean
        const message = e instanceof Error ? e.message : "Something went wrong.";
        if (/offline/i.test(message)) setStatus(false);
        addMessage("error", message);
      } finally {
        busy = false;
        send.disabled = false;
      }
    }

    toggle.addEventListener("click", () => open(panel.hidden));
    root.querySelector("[data-ask-close]")!.addEventListener("click", () => open(false));
    root.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !panel.hidden) {
        open(false);
        toggle.focus();
      }
    });
    suggestions.addEventListener("click", (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>(".ask__chip");
      if (chip) ask(chip.textContent!.trim());
    });
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const q = input.value;
      input.value = "";
      ask(q);
    });
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
