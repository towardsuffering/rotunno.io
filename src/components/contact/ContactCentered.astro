---
import ContactForm from "@/components/forms/ContactFormTwoCol.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getLocalizedRoute, getTranslatedData, useTranslations } from "@/js/translationUtils";
const currLocale = getLocaleFromUrl(Astro.url);
const t = useTranslations(currLocale);
---

<section id="contact" class="site-container scroll-mt-20 py-8">
  <div class="mx-auto max-w-3xl">
    <div class="text-center" data-reveal="pop">
      <h2 class="h1 mb-6">Let's Turn Tidbits into Confidence</h2>
    </div>

    <!-- Drop Me a Line -->
    <div class="rounded-xl border p-6 text-left shadow-md" data-reveal="rise" data-reveal-delay="0.2">
      <h3 class="font-heading mb-4 text-2xl font-semibold">Drop Me a Line</h3>
      <ContactForm />
    </div>

  </div>
</section>
