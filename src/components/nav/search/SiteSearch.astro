---
/**
 * Site search for the nav. variant="desktop": inline box with dropdown results.
 * variant="mobile": a search button (outside the hamburger) that opens a full-width bar.
 * Results come from /search.json, loaded on first use.
 */
interface Props {
  variant: "desktop" | "mobile";
  class?: string;
}
const { variant, class: className } = Astro.props as Props;
const id = `site-search-${variant}`;
---

{
  variant === "desktop" ? (
    <div class:list={["site-search relative", className]} data-site-search>
      <label for={id} class="sr-only">Search site</label>
      <div class="search-field">
        <svg viewBox="0 0 24 24" class="size-4 shrink-0 opacity-70" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        </svg>
        <input id={id} type="search" placeholder="Search site" autocomplete="off" role="combobox" aria-expanded="false" aria-controls={`${id}-results`} aria-autocomplete="list" data-search-input />
      </div>
      <ul id={`${id}-results`} class="search-results" role="listbox" hidden data-search-results />
    </div>
  ) : (
    <div class:list={["site-search", className]} data-site-search data-mobile>
      <button type="button" class="search-toggle" aria-label="Search site" aria-expanded="false" aria-controls={`${id}-panel`} data-search-toggle>
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
        </svg>
      </button>
      <div id={`${id}-panel`} class="search-panel" hidden data-search-panel>
        <div class="site-container py-3">
          <label for={id} class="sr-only">Search site</label>
          <div class="search-field">
            <svg viewBox="0 0 24 24" class="size-4 shrink-0 opacity-70" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
            </svg>
            <input id={id} type="search" placeholder="Search site" autocomplete="off" role="combobox" aria-expanded="false" aria-controls={`${id}-results`} aria-autocomplete="list" data-search-input />
            <button type="button" class="text-muted-foreground text-sm font-medium" data-search-close>Close</button>
          </div>
          <ul id={`${id}-results`} class="search-results search-results--mobile" role="listbox" hidden data-search-results />
        </div>
      </div>
    </div>
  )
}

<style>
  .search-field {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.4rem;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-background) 85%, transparent);
    color: var(--color-foreground);
  }
  .search-field:focus-within {
    border-color: var(--color-primary);
  }
  .search-field input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    outline: none;
    font-size: 0.9rem;
    padding: 0;
    box-shadow: none;
  }
  .search-field input::-webkit-search-cancel-button {
    display: none;
  }
  .search-results {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: min(26rem, 90vw);
    max-height: 70vh;
    overflow-y: auto;
    padding: 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 0.9rem;
    background: var(--color-background);
    box-shadow: 0 18px 40px -12px rgb(0 0 0 / 0.35);
    z-index: 50;
  }
  .search-results--mobile {
    position: static;
    width: 100%;
    margin-top: 0.6rem;
    max-height: 60vh;
    box-shadow: none;
  }
  .search-results :global(a) {
    display: block;
    padding: 0.55rem 0.7rem;
    border-radius: 0.6rem;
  }
  .search-results :global(a[aria-selected="true"]),
  .search-results :global(a:hover) {
    background: var(--color-muted);
  }
  .search-results :global(.r-title) {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-foreground);
    line-height: 1.3;
  }
  .search-results :global(.r-meta) {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.75rem;
    color: var(--color-muted-foreground);
  }
  .search-results :global(mark) {
    background: color-mix(in srgb, var(--color-primary) 25%, transparent);
    color: inherit;
    border-radius: 0.15rem;
  }
  .search-results :global(.r-empty) {
    padding: 0.7rem;
    font-size: 0.85rem;
    color: var(--color-muted-foreground);
  }
  .search-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    color: inherit;
  }
  .search-panel {
    position: fixed;
    left: 0;
    right: 0;
    top: var(--search-top, 6rem);
    z-index: 40;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 18px 30px -18px rgb(0 0 0 / 0.4);
  }
</style>

<script>
  type Entry = { t: string; d: string; u: string; k: string; g: string[]; y?: number };
  let index: Promise<Entry[]> | null = null;
  const loadIndex = () => (index ??= fetch("/search.json").then((r) => r.json()).catch(() => []));

  const norm = (s: string) => s.toLowerCase().normalize("NFKD").replace(/[̀-ͯ]/g, "");
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const humanize = (s: string) => s.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

  function search(entries: Entry[], q: string) {
    const terms = norm(q).split(/\s+/).filter(Boolean);
    if (!terms.length) return [];
    return entries
      .map((e) => {
        const title = norm(e.t), desc = norm(e.d), tags = norm(e.g.join(" "));
        let score = 0;
        for (const t of terms) {
          const s = (title.includes(t) ? 6 : 0) + (tags.includes(t) ? 3 : 0) + (desc.includes(t) ? 1 : 0);
          if (!s) return { e, score: 0 }; // every term must match somewhere
          score += s + (title.startsWith(t) ? 2 : 0);
        }
        return { e, score };
      })
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score || (b.e.y ?? 9999) - (a.e.y ?? 9999))
      .slice(0, 7)
      .map((r) => r.e);
  }

  function highlight(text: string, q: string) {
    let out = esc(text);
    for (const t of norm(q).split(/\s+/).filter((x) => x.length > 1)) {
      out = out.replace(new RegExp(`(${t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})`, "gi"), "<mark>$1</mark>");
    }
    return out;
  }

  function initSearch(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = "true";
    const input = root.querySelector<HTMLInputElement>("[data-search-input]")!;
    const results = root.querySelector<HTMLUListElement>("[data-search-results]")!;
    let active = -1;

    const close = () => {
      results.hidden = true;
      input.setAttribute("aria-expanded", "false");
      active = -1;
    };
    const setActive = (i: number) => {
      const links = [...results.querySelectorAll<HTMLAnchorElement>("a")];
      if (!links.length) return;
      active = (i + links.length) % links.length;
      links.forEach((l, j) => l.setAttribute("aria-selected", String(j === active)));
      links[active].scrollIntoView({ block: "nearest" });
    };
    const render = async () => {
      const q = input.value.trim();
      if (!q) return close();
      const found = search(await loadIndex(), q);
      results.innerHTML = found.length
        ? found
            .map(
              (e, i) =>
                `<li role="none"><a role="option" id="${input.id}-opt-${i}" aria-selected="false" href="${esc(e.u)}"><span class="r-title">${highlight(e.t, q)}</span><span class="r-meta">${esc(e.k)}${e.k === "Post" ? ` · ${esc(humanize(e.g[0] ?? ""))} · ${e.y}` : ""}</span></a></li>`,
            )
            .join("")
        : `<li class="r-empty">Nothing on the site matches "${esc(q)}".</li>`;
      results.hidden = false;
      input.setAttribute("aria-expanded", "true");
      active = -1;
    };

    input.addEventListener("focus", () => {
      loadIndex();
      if (input.value.trim()) render();
    });
    input.addEventListener("input", render);
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") (e.preventDefault(), setActive(active + 1));
      else if (e.key === "ArrowUp") (e.preventDefault(), setActive(active - 1));
      else if (e.key === "Enter") {
        const target = results.querySelectorAll<HTMLAnchorElement>("a")[active < 0 ? 0 : active];
        if (target) (e.preventDefault(), target.click());
      } else if (e.key === "Escape") (close(), input.blur());
    });
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) close();
    });
    results.addEventListener("click", () => {
      close();
      closePanel?.();
    });

    // mobile: toggle button + full-width panel under the header
    let closePanel: (() => void) | undefined;
    const toggle = root.querySelector<HTMLButtonElement>("[data-search-toggle]");
    const panel = root.querySelector<HTMLElement>("[data-search-panel]");
    if (toggle && panel) {
      closePanel = () => {
        panel.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
        close();
      };
      toggle.addEventListener("click", () => {
        const open = panel.hidden;
        // sit flush under the (fixed) header, whatever its current height
        const nav = document.getElementById("nav__container");
        if (nav) panel.style.setProperty("--search-top", `${nav.getBoundingClientRect().bottom}px`);
        panel.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
        if (open) setTimeout(() => input.focus(), 0);
        else close();
      });
      root.querySelector("[data-search-close]")?.addEventListener("click", closePanel);
      input.addEventListener("keydown", (e) => e.key === "Escape" && closePanel?.());
    }
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>("[data-site-search]").forEach(initSearch);
  }
  initAll();
  document.addEventListener("astro:after-swap", initAll);

  // "/" focuses the desktop search from anywhere (except while typing in a field)
  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    if (e.key !== "/" || t.closest("input, textarea, [contenteditable=true]")) return;
    const desktop = document.getElementById("site-search-desktop") as HTMLInputElement | null;
    if (desktop && desktop.offsetParent) (e.preventDefault(), desktop.focus());
  });
</script>
