---
import "@fontsource/caveat/latin-600.css";

import Button from "@/components/button/Button.astro";
import LanguageSelect from "@/components/language-select/LanguageSelect.astro";
import SiteLogo from "@/components/site-logo/SiteLogo.astro";
import SiteSearch from "@/components/nav/search/SiteSearch.astro";
import ThemeToggle from "@/components/theme-toggle/ThemeToggle.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getTranslatedData } from "@/js/translationUtils";

import MobileNav from "./mobile-nav/MobileNav.astro";
import MegaMenuDropdownToggle from "./nav-dropdown/MegaMenuDropdownToggle.astro";
import NavDropdown from "./nav-dropdown/NavDropdown.astro";
import NavLink from "./NavLink.astro";

const currLocale = getLocaleFromUrl(Astro.url);
const navData = getTranslatedData("navData", currLocale);
import { locales } from "@/config/siteSettings.json";
// console.log(JSON.stringify(navData, null, 2));

interface Props {
  navStyle?: "default" | "dark";
  transparentNav?: boolean;
}

const { navStyle = "default", transparentNav = false } = Astro.props as Props;

// the hand-drawn "look here" arrow under the Blog tab only appears on the homepage
const showBlogPointer = Astro.url.pathname === "/";
---

<div
  id="nav__container"
  class:list={[
    "navbar--initial fixed top-0 left-0 z-30 flex w-full flex-col border-b transition-all duration-300",
    { dark: navStyle === "dark" },
    { "navbar--has-hero": transparentNav },
  ]}
>
  <!-- Contact strip -->
  <div class="bg-background/80 border-b border-border/50">
    <div class="site-container flex flex-wrap items-center justify-center gap-x-6 gap-y-1 py-1 text-xs md:justify-end md:text-sm">
      <a href="tel:+17272212980" class="text-muted-foreground font-medium hover:text-primary-accent -my-1 inline-block py-1 transition-colors">
        +1 (727) 221-2980
      </a>
      <a href="mailto:chrisrotunno@icloud.com" class="text-primary-accent font-medium hover:underline -my-1 inline-block py-1">
        chrisrotunno@icloud.com
      </a>
      <div class="flex items-center gap-1">
        <a href="https://www.linkedin.com/in/chris-rotunno/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-muted-foreground hover:text-primary-accent -my-1.5 inline-flex p-1.5 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z"/><path d="M8 11l0 5"/><path d="M8 8l0 .01"/><path d="M12 16l0 -5"/><path d="M16 16v-3a2 2 0 0 0 -4 0"/></svg>
        </a>
        <a href="https://www.instagram.com/chrisrotunno/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-muted-foreground hover:text-primary-accent -my-1.5 inline-flex p-1.5 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4m0 4a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z"/><path d="M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"/><path d="M16.5 7.5l0 .01"/></svg>
        </a>
        <a href="https://www.youtube.com/@chris-rotunno" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-muted-foreground hover:text-primary-accent -my-1.5 inline-flex p-1.5 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8z"/><path d="M10 9l5 3l-5 3z"/></svg>
        </a>
        <a href="https://www.facebook.com/crotunno92" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-muted-foreground hover:text-primary-accent -my-1.5 inline-flex p-1.5 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"/></svg>
        </a>
      </div>
    </div>
  </div>
  <div class="mx-auto flex w-full">
    <div class="site-container flex h-14 w-full items-center">
      <header class="relative flex w-full items-center gap-2">
        <!-- home button / image -->
        <div class="nav-logo flex flex-auto justify-start">
          <SiteLogo />
        </div>

        <!-- <div class="flex flex-auto justify-center">
          
        </div> -->

        <!-- desktop nav menu -->
        <div class="flex flex-auto justify-end">
          <SiteSearch variant="desktop" class="my-auto hidden w-52 lg:block xl:w-64" />

          <nav class="my-auto hidden md:block">
            <ul class="flex h-fit items-center px-4">
              {
                // if dropdown exists, setup the dropdown, otherwise it is just a link
                navData.map((navItem) =>
                  "dropdown" in navItem ? (
                    // non-mobile dropdown menu
                    <li>
                      <NavDropdown navItem={navItem} />
                    </li>
                  ) : "megaMenuColumns" in navItem ? (
                    <MegaMenuDropdownToggle {navItem} />
                  ) : (
                    // normal nav link; Blog gets a hand-drawn arrow pointing up at it
                    <li class:list={[{ relative: navItem.link === "/blog" }]}>
                      <NavLink {navItem} />
                      {navItem.link === "/blog" && showBlogPointer && (
                        <span class="blog-pointer" aria-hidden="true">
                          <svg viewBox="0 0 80 64" fill="none">
                            <path
                              class="blog-pointer__line"
                              d="M20 50 C 25 40, 32 46, 38 34 S 52 14, 58 8"
                              stroke="currentColor"
                              stroke-width="2.5"
                              stroke-linecap="round"
                            />
                            <path
                              class="blog-pointer__head"
                              d="M47 10 L 59 7 L 58 19"
                              stroke="currentColor"
                              stroke-width="2.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                          <span class="blog-pointer__note">drafted by me, written with Opus 5.5</span>
                        </span>
                      )}
                    </li>
                  ),
                )
              }
            </ul>
          </nav>

          <ThemeToggle class="mr-3 -ml-4 hidden md:block" />

          <Button variant="primary" class="my-auto hidden px-4 py-2 md:flex" href="/support">
            💵 Support My Work 💵
          </Button>

          {locales.length > 1 && <LanguageSelect class="ml-4 hidden md:block" />}

          <!-- mobile nav menu, only load on small screens where it is visible -->
          <!-- mobile/tablet search sits outside the hamburger menu -->
          <SiteSearch variant="mobile" class="my-auto flex lg:hidden" />

          <div class="md:hidden">
            <MobileNav />
          </div>
        </div>
      </header>
    </div>
  </div>
</div>

<style>
  @import "tailwindcss/theme" theme(reference);
  @import "@/styles/tailwind-theme.css" theme(reference);

  .navbar--scrolled {
    @apply bg-background border-b;
  }

  .navbar--scrolled :global(.catchphrase) {
    background: transparent !important;
    color: var(--color-primary-accent);
    padding: 0;
  }

  .navbar--initial {
    @apply border-b-transparent bg-transparent py-2;
  }

  /* White text only when nav is transparent over a hero image */
  .navbar--has-hero.navbar--initial :global(.nav__link--base) {
    @apply text-white/90 hover:text-white hover:bg-white/10;
  }

  /* over the dark hero photo the tagline stays bright sky blue in both themes */
  .navbar--has-hero.navbar--initial :global(.catchphrase) {
    color: #38bdf8;
  }

  .navbar--has-hero.navbar--initial :global(.nav-logo a) {
    @apply text-white;
    text-shadow: 0 1px 4px rgba(0,0,0,0.6);
  }

  .navbar--has-hero.navbar--initial :global(#mobile-nav__burger) {
    @apply text-white;
  }

  /* hand-drawn arrow under the Blog tab, pointing up at it */
  .blog-pointer {
    position: absolute;
    top: calc(100% - 2px);
    right: 55%;
    width: 72px;
    height: 58px;
    pointer-events: none;
    color: var(--color-primary-accent);
    transition: opacity 0.3s ease;
  }
  .blog-pointer svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .navbar--has-hero.navbar--initial .blog-pointer {
    color: #fff;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.55));
  }
  .navbar--scrolled .blog-pointer {
    opacity: 0;
  }
  /* handwritten note at the arrow's tail */
  .blog-pointer__note {
    position: absolute;
    top: 46px;
    right: calc(100% - 10px);
    white-space: nowrap;
    font-family: "Caveat", cursive;
    font-weight: 600;
    font-size: 1.35rem;
    line-height: 1;
    transform: rotate(-4deg);
    transform-origin: right center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .blog-pointer__line {
      stroke-dasharray: 90;
      stroke-dashoffset: 90;
      animation: pointer-draw 0.9s 0.6s ease-out forwards;
    }
    .blog-pointer__head {
      stroke-dasharray: 30;
      stroke-dashoffset: 30;
      animation: pointer-draw 0.3s 1.4s ease-out forwards;
    }
    .blog-pointer svg {
      animation: pointer-bob 2.4s 1.8s ease-in-out infinite;
    }
    .blog-pointer__note {
      opacity: 0;
      animation: note-in 0.5s 0.3s ease-out forwards;
    }
  }
  @keyframes pointer-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes note-in {
    from {
      opacity: 0;
      translate: -6px 4px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @keyframes pointer-bob {
    0%, 100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(3px, -4px);
    }
  }
</style>

<script>
  let navbar: HTMLElement | null;

  function scrollHandler() {
    if (navbar) {
      if (window.scrollY > 50) {
        // if we have scrolled down the page a bit, add a frosted-glass look to the navbar
        navbar.classList.add("navbar--scrolled");
        navbar.classList.remove("navbar--initial");
      } else {
        navbar.classList.add("navbar--initial");
        navbar.classList.remove("navbar--scrolled");
      }
    }
  }

  function initNav() {
    navbar = document.getElementById("nav__container");
    window.addEventListener("scroll", scrollHandler, { passive: true });
  }

  // runs on initial page load
  initNav();

  // runs on view transitions navigation. Not needed if item has "transition:persist"
  document.addEventListener("astro:after-swap", initNav);
</script>
