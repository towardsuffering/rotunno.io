---
import { type CollectionEntry, getEntries } from "astro:content";

import PostCover from "@/components/blog/PostCover.astro";
import { getReadingTime } from "@/js/blogUtils";
import { postNotebookMinutes } from "@/js/notebookUtils";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { formatDate, humanize, slugify } from "@/js/textUtils";
import { getLocalizedRoute } from "@/js/translationUtils";

interface Props {
  post: CollectionEntry<"blog">;
  showDescription?: boolean;
  // "feature" is the large lead-story layout used at the top of the blog index
  variant?: "default" | "feature";
  class?: string;
  rest?: any; // catch-all for any additional parameters, such as "aria-label"
}

const {
  post,
  showDescription = false,
  variant = "default",
  class: className,
  ...rest
} = Astro.props as Props;
const { title, description, categories, authors, pubDate, youtubeId } = post.data;

const currLocale = getLocaleFromUrl(Astro.url);
const authorsData = await getEntries(authors);
const href = getLocalizedRoute(currLocale, `/blog/${post.id}/`);
const readingTime = getReadingTime(post.body, postNotebookMinutes(post.filePath));
const isFeature = variant === "feature";
---

<article
  class:list={[
    "group relative",
    isFeature && "grid items-center gap-8 md:grid-cols-[1.35fr_1fr] md:gap-12",
    className,
  ]}
  {...rest}
>
  <a href={href} class="block overflow-hidden rounded-lg border" tabindex="-1" aria-hidden="true">
    <PostCover
      post={post}
      width={isFeature ? 1200 : 800}
      eager={isFeature}
      class="transition-transform duration-700 group-hover:scale-[1.03]"
    />
  </a>

  <div class:list={[!isFeature && "mt-5"]}>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-[0.14em] uppercase">
      <a
        href={getLocalizedRoute(currLocale, `/categories/${slugify(categories[0])}`)}
        class="text-primary relative z-10 hover:underline"
      >
        {humanize(categories[0])}
      </a>
      {
        youtubeId && (
          <span class="text-muted-foreground flex items-center gap-1">
            <svg viewBox="0 0 24 24" class="size-3" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
            Video
          </span>
        )
      }
    </div>

    <h2
      class:list={[
        "font-heading mt-3 font-semibold tracking-tight text-balance",
        isFeature ? "text-2xl leading-tight md:text-4xl" : "text-lg leading-snug md:text-xl",
      ]}
    >
      <a href={href} class="decoration-primary/60 underline-offset-4 group-hover:underline">
        {title}
      </a>
    </h2>

    {
      (showDescription || isFeature) && (
        <p
          class:list={[
            "text-muted-foreground mt-3 line-clamp-3",
            isFeature ? "md:text-lg" : "text-sm md:text-base",
          ]}
        >
          {description}
        </p>
      )
    }

    <div class="text-muted-foreground mt-4 flex flex-wrap items-center gap-x-2 text-sm">
      <span class="text-foreground font-medium">{authorsData[0].data.name}</span>
      <span aria-hidden="true">&middot;</span>
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate, currLocale)}</time>
      <span aria-hidden="true">&middot;</span>
      <span>{readingTime} min read</span>
    </div>
  </div>
</article>
