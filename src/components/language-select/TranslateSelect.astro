---
/**
 * "Translate" menu: opens the current page in Google Translate's website proxy
 * (rotunno-ai.translate.goog), which machine-translates every page and keeps links inside the
 * translation as the visitor browses. Nothing loads from Google until a language is picked.
 * A native select, so a long list stays easy to scroll and type into on phones.
 */
import { Icon } from "astro-icon/components";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// [Google Translate code, label]; native name first so each reader can find their own
const LANGUAGES: [string, string][] = [
  ["af", "Afrikaans"],
  ["sq", "Shqip (Albanian)"],
  ["am", "አማርኛ (Amharic)"],
  ["ar", "العربية (Arabic)"],
  ["hy", "Հայերեն (Armenian)"],
  ["bn", "বাংলা (Bengali)"],
  ["bg", "Български (Bulgarian)"],
  ["my", "မြန်မာ (Burmese)"],
  ["zh-CN", "简体中文 (Chinese, Simplified)"],
  ["zh-TW", "繁體中文 (Chinese, Traditional)"],
  ["hr", "Hrvatski (Croatian)"],
  ["cs", "Čeština (Czech)"],
  ["da", "Dansk (Danish)"],
  ["nl", "Nederlands (Dutch)"],
  ["tl", "Filipino"],
  ["fi", "Suomi (Finnish)"],
  ["fr", "Français (French)"],
  ["de", "Deutsch (German)"],
  ["el", "Ελληνικά (Greek)"],
  ["gu", "ગુજરાતી (Gujarati)"],
  ["ht", "Kreyòl Ayisyen (Haitian Creole)"],
  ["ha", "Hausa"],
  ["iw", "עברית (Hebrew)"],
  ["hi", "हिन्दी (Hindi)"],
  ["hmn", "Hmong"],
  ["hu", "Magyar (Hungarian)"],
  ["ig", "Igbo"],
  ["id", "Bahasa Indonesia (Indonesian)"],
  ["it", "Italiano (Italian)"],
  ["ja", "日本語 (Japanese)"],
  ["kn", "ಕನ್ನಡ (Kannada)"],
  ["km", "ខ្មែរ (Khmer)"],
  ["ko", "한국어 (Korean)"],
  ["lo", "ລາວ (Lao)"],
  ["ms", "Bahasa Melayu (Malay)"],
  ["ml", "മലയാളം (Malayalam)"],
  ["mr", "मराठी (Marathi)"],
  ["ne", "नेपाली (Nepali)"],
  ["no", "Norsk (Norwegian)"],
  ["ps", "پښتو (Pashto)"],
  ["fa", "فارسی (Persian)"],
  ["pl", "Polski (Polish)"],
  ["pt", "Português (Portuguese)"],
  ["pa", "ਪੰਜਾਬੀ (Punjabi)"],
  ["ro", "Română (Romanian)"],
  ["ru", "Русский (Russian)"],
  ["sr", "Српски (Serbian)"],
  ["so", "Soomaali (Somali)"],
  ["es", "Español (Spanish)"],
  ["sw", "Kiswahili (Swahili)"],
  ["sv", "Svenska (Swedish)"],
  ["ta", "தமிழ் (Tamil)"],
  ["te", "తెలుగు (Telugu)"],
  ["th", "ไทย (Thai)"],
  ["tr", "Türkçe (Turkish)"],
  ["uk", "Українська (Ukrainian)"],
  ["ur", "اردو (Urdu)"],
  ["vi", "Tiếng Việt (Vietnamese)"],
  ["yo", "Yorùbá (Yoruba)"],
  ["zu", "isiZulu (Zulu)"],
];

// the proxy's host for this site: dots become dashes (and dashes double), under translate.goog
const site = new URL(Astro.site ?? "https://rotunno.ai");
const proxyHost = `${site.hostname.replace(/-/g, "--").replace(/\./g, "-")}.translate.goog`;
---

<label class:list={["translate-select text-muted-foreground hover:text-primary-accent relative inline-flex items-center gap-1 transition-colors", className]}>
  <Icon name="tabler/language" aria-hidden="true" class="size-4 shrink-0" />
  <span class="sr-only">Translate this site</span>
  <select data-translate data-site={site.origin} data-proxy={proxyHost} class="translate-select__menu">
    <option value="" selected>Translate</option>
    <option value="en">English (original)</option>
    {LANGUAGES.map(([code, label]) => <option value={code}>{label}</option>)}
  </select>
  <Icon name="tabler/chevron-down" aria-hidden="true" class="pointer-events-none size-3.5 shrink-0" />
</label>

<style>
  .translate-select__menu {
    appearance: none;
    max-width: 7.5rem;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    text-overflow: ellipsis;
  }
  .translate-select__menu:focus-visible {
    outline: 2px solid var(--color-primary-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
  /* the open list follows the site's theme */
  .translate-select__menu option {
    background: var(--background);
    color: var(--foreground);
  }
</style>

<script>
  // one listener for every menu on the page, set up once (the nav survives view transitions)
  if (!(window as any).__translateSelect) {
    (window as any).__translateSelect = true;
    document.addEventListener("change", (event) => {
      const menu = event.target as HTMLSelectElement;
      if (!menu.matches?.("select[data-translate]") || !menu.value) return;
      const path = location.pathname + location.hash;
      // English goes back to the site itself; any other language opens the page through the proxy
      location.href =
        menu.value === "en"
          ? menu.dataset.site + path
          : `https://${menu.dataset.proxy}${location.pathname}?_x_tr_sl=en&_x_tr_tl=${menu.value}&_x_tr_hl=${menu.value}${location.hash}`;
    });
  }

  // inside a translation, the menu shows the language being read
  function showCurrent() {
    const lang = new URLSearchParams(location.search).get("_x_tr_tl");
    if (!lang) return;
    document.querySelectorAll<HTMLSelectElement>("select[data-translate]").forEach((menu) => (menu.value = lang));
  }
  showCurrent();
  document.addEventListener("astro:page-load", showCurrent);
</script>
