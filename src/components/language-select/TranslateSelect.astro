---
/**
 * "Translate" menu: translates the page in place with Google's website translator, so the visitor
 * stays on this site and every script and animation keeps running (the translate.goog proxy broke
 * them). The choice lives in Google's own "googtrans" cookie, so later pages load translated too.
 * Nothing loads from Google until a language is picked.
 * A native select, so a long list stays easy to scroll and type into on phones.
 */
import { Icon } from "astro-icon/components";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// [Google Translate code, label]; native name first so each reader can find their own
const LANGUAGES: [string, string][] = [
  ["af", "Afrikaans"],
  ["sq", "Shqip (Albanian)"],
  ["am", "አማርኛ (Amharic)"],
  ["ar", "العربية (Arabic)"],
  ["hy", "Հայերեն (Armenian)"],
  ["bn", "বাংলা (Bengali)"],
  ["bg", "Български (Bulgarian)"],
  ["my", "မြန်မာ (Burmese)"],
  ["zh-CN", "简体中文 (Chinese, Simplified)"],
  ["zh-TW", "繁體中文 (Chinese, Traditional)"],
  ["hr", "Hrvatski (Croatian)"],
  ["cs", "Čeština (Czech)"],
  ["da", "Dansk (Danish)"],
  ["nl", "Nederlands (Dutch)"],
  ["tl", "Filipino"],
  ["fi", "Suomi (Finnish)"],
  ["fr", "Français (French)"],
  ["de", "Deutsch (German)"],
  ["el", "Ελληνικά (Greek)"],
  ["gu", "ગુજરાતી (Gujarati)"],
  ["ht", "Kreyòl Ayisyen (Haitian Creole)"],
  ["ha", "Hausa"],
  ["iw", "עברית (Hebrew)"],
  ["hi", "हिन्दी (Hindi)"],
  ["hmn", "Hmong"],
  ["hu", "Magyar (Hungarian)"],
  ["ig", "Igbo"],
  ["id", "Bahasa Indonesia (Indonesian)"],
  ["it", "Italiano (Italian)"],
  ["ja", "日本語 (Japanese)"],
  ["kn", "ಕನ್ನಡ (Kannada)"],
  ["km", "ខ្មែរ (Khmer)"],
  ["ko", "한국어 (Korean)"],
  ["lo", "ລາວ (Lao)"],
  ["ms", "Bahasa Melayu (Malay)"],
  ["ml", "മലയാളം (Malayalam)"],
  ["mr", "मराठी (Marathi)"],
  ["ne", "नेपाली (Nepali)"],
  ["no", "Norsk (Norwegian)"],
  ["ps", "پښتو (Pashto)"],
  ["fa", "فارسی (Persian)"],
  ["pl", "Polski (Polish)"],
  ["pt", "Português (Portuguese)"],
  ["pa", "ਪੰਜਾਬੀ (Punjabi)"],
  ["ro", "Română (Romanian)"],
  ["ru", "Русский (Russian)"],
  ["sr", "Српски (Serbian)"],
  ["so", "Soomaali (Somali)"],
  ["es", "Español (Spanish)"],
  ["sw", "Kiswahili (Swahili)"],
  ["sv", "Svenska (Swedish)"],
  ["ta", "தமிழ் (Tamil)"],
  ["te", "తెలుగు (Telugu)"],
  ["th", "ไทย (Thai)"],
  ["tr", "Türkçe (Turkish)"],
  ["uk", "Українська (Ukrainian)"],
  ["ur", "اردو (Urdu)"],
  ["vi", "Tiếng Việt (Vietnamese)"],
  ["yo", "Yorùbá (Yoruba)"],
  ["zu", "isiZulu (Zulu)"],
];

---

<label translate="no" class:list={["notranslate translate-select text-muted-foreground hover:text-primary-accent relative inline-flex items-center gap-1 transition-colors", className]}>
  <Icon name="tabler/language" aria-hidden="true" class="size-4 shrink-0" />
  <span class="sr-only">Translate this site</span>
  <select data-translate class="translate-select__menu">
    <option value="" selected>Translate</option>
    <option value="en">English (original)</option>
    {LANGUAGES.map(([code, label]) => <option value={code}>{label}</option>)}
  </select>
  <Icon name="tabler/chevron-down" aria-hidden="true" class="pointer-events-none size-3.5 shrink-0" />
</label>

<style>
  .translate-select__menu {
    appearance: none;
    max-width: 7.5rem;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    text-overflow: ellipsis;
  }
  .translate-select__menu:focus-visible {
    outline: 2px solid var(--color-primary-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
  /* the open list follows the site's theme */
  .translate-select__menu option {
    background: var(--background);
    color: var(--foreground);
  }
</style>

<script is:inline>
  // inline and run once per full page load: it has to manage Google's script and cookie itself
  (function () {
    const COOKIE = "googtrans";
    const current = () => {
      const m = document.cookie.match(/(?:^|;\s*)googtrans=\/en\/([^;]+)/);
      return m && m[1] !== "en" ? decodeURIComponent(m[1]) : "";
    };
    // Google may write the cookie on the bare domain as well, so clear both
    const setCookie = (value) => {
      const expiry = value ? "" : ";expires=Thu, 01 Jan 1970 00:00:00 GMT";
      document.cookie = `${COOKIE}=${value};path=/${expiry}`;
      document.cookie = `${COOKIE}=${value};path=/;domain=${location.hostname}${expiry}`;
      document.cookie = `${COOKIE}=${value};path=/;domain=.${location.hostname.replace(/^www\./, "")}${expiry}`;
    };
    // a link ending in #googtrans(en|es) opens the site already in that language
    const linked = location.hash.match(/googtrans\(en\|([\w-]+)\)/);
    if (linked) setCookie(linked[1] === "en" ? "" : `/en/${linked[1]}`);
    const showCurrent = () =>
      document.querySelectorAll("select[data-translate]").forEach((menu) => (menu.value = current()));

    if (!window.__translateSelect) {
      window.__translateSelect = true;
      document.addEventListener("change", (event) => {
        const menu = event.target;
        if (!menu.matches || !menu.matches("select[data-translate]") || !menu.value) return;
        setCookie(menu.value === "en" ? "" : `/en/${menu.value}`);
        location.reload();
      });
      // a translated page can't follow a client-side page swap, so load the next page in full instead
      document.addEventListener("astro:after-swap", () => {
        if (current()) location.reload();
        else showCurrent();
      });
      // load Google's translator only when a language has been chosen
      if (current()) {
        window.googleTranslateInit = () =>
          new window.google.translate.TranslateElement({ pageLanguage: "en", autoDisplay: false }, "google-translate-host");
        const host = document.createElement("div");
        host.id = "google-translate-host";
        host.hidden = true;
        document.body.appendChild(host);
        const script = document.createElement("script");
        script.src = "https://translate.google.com/translate_a/element.js?cb=googleTranslateInit";
        script.async = true;
        document.head.appendChild(script);
      }
    }
    showCurrent();
  })();
</script>

<style is:global>
  /* hide the bar and hover popups Google adds, and keep the page from shifting down for them */
  body > .skiptranslate,
  iframe.skiptranslate,
  #goog-gt-tt,
  .goog-te-balloon-frame {
    display: none !important;
  }
  body {
    top: 0 !important;
  }
  font[style] {
    background: none !important;
    box-shadow: none !important;
  }
</style>
