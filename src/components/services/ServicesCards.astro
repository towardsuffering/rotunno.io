---
import { Icon } from "astro-icon/components";

import Button from "@/components/button/Button.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getLocalizedRoute } from "@/js/translationUtils";

const currLocale = getLocaleFromUrl(Astro.url);

// in the order the work happens: structure the fragments, fix what breaks, catch the pattern, hand it to people
const pillars = [
  {
    icon: "tabler/briefcase",
    title: "Finding Structure",
    slug: "finding-structure",
  },
  {
    icon: "tabler/database",
    title: "Troubleshooting Systems",
    slug: "troubleshooting-systems",
  },
  {
    icon: "tabler/chart-dots",
    title: "Predicting Patterns",
    slug: "predicting-patterns",
  },
  {
    icon: "tabler/users",
    title: "Empowering Others",
    slug: "empowering-others",
  },
];

type Star = [x: number, y: number, size: number];
// joints of every column, in percent of the column box (see the svg paths below)
const JOINTS: Star[] = [
  [0, 1, 1.2], [100, 1, 1.2], [6, 8, 0.8], [94, 8, 0.8],
  [11, 91, 0.8], [89, 91, 0.8], [0, 99, 1.1], [100, 99, 1.1],
];
// a few stars along the shaft's edges, different on each column so they read as constellations, not clones
const EDGE_YS = [[30, 64], [22, 52, 76], [40, 70], [26, 58]];
const pillarStars = (idx: number): Star[] => [
  ...JOINTS,
  ...EDGE_YS[idx % EDGE_YS.length].map((y, i): Star => {
    const left = i % 2 === 0;
    const x = left ? 13 - (2 * (y - 8)) / 83 : 87 + (2 * (y - 8)) / 83; // on the tapered edge
    return [x, y, 0.55 + ((idx + i) % 3) * 0.15];
  }),
];
// roof (viewBox 100x24): the pediment's corners and a few along its slopes, then the beam's ends
const ROOF_STARS: Star[] = [
  [0, 16, 1.2], [50, 1, 1.5], [100, 16, 1.2], [24, 8.6, 0.7], [76, 8.6, 0.7],
  [2, 22, 0.9], [98, 22, 0.9], [36, 22, 0.6], [64, 22, 0.6],
];
// steps (viewBox 100x12): each line's ends
const STEP_STARS: Star[] = [[4, 2, 0.8], [96, 2, 0.8], [1.5, 6, 0.9], [98.5, 6, 0.9], [0, 10, 1.1], [100, 10, 1.1]];
---

<section id="capabilities-cards" class="my-12 py-12">
  <div class="site-container" id="capabilities-cards-trigger">
    <h2 class="h2 mx-auto max-w-3xl text-center" data-reveal="pop">How I Connect the Dots</h2>
    <p class="text-muted-foreground mx-auto mt-4 max-w-2xl text-center md:text-lg">
      Four pillars, in the order the work happens: from scattered data to a call someone can make with confidence.
    </p>

    <div class="temple relative mx-auto mt-16 max-w-5xl">
      <!-- roof: a constellation pediment over a starlit beam -->
      <div class="relative hidden lg:block" aria-hidden="true">
        <svg class="block h-24 w-full" viewBox="0 0 100 24" preserveAspectRatio="none">
          <polygon class="temple-glass" points="0,16 50,1 100,16" />
          <path class="temple-line" d="M0 16L50 1L100 16Z M2 16V22H98V16" />
          <path class="temple-dots" d="M2 19H98" />
        </svg>
        {ROOF_STARS.map(([x, y, s]) => <span class="cstar" style={`left:${x}%;top:${(y / 24) * 100}%;--s:${s}`} />)}
      </div>

      <div
        class="grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-8 lg:grid-cols-4 lg:gap-x-10 lg:px-10"
        id="capabilities-list"
      >
        {
          pillars.map((p, idx) => (
            <div class="flex justify-center" data-reveal="rise" data-reveal-delay={idx * 0.1}>
              <!-- the reveal animation owns this wrapper's transform; focus styles live on the inner column -->
              <div
                class="pillar-column relative flex w-full max-w-[230px] cursor-pointer flex-col items-center text-center"
                data-capability-index={idx}
              >
                <!-- the column drawn as a constellation: capital, a shaft tapering toward the top, and a base,
                     with stars at the joints and a few along the shaft's edges -->
                <svg
                  class="pointer-events-none absolute inset-0 h-full w-full"
                  viewBox="0 0 100 100"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <polygon class="pillar-glass" points="13,8 87,8 89,91 11,91" />
                  <path class="pillar-flute" d="M31 13V87M50 13V87M69 13V87" />
                  <path class="pillar-line" d="M0 1H100L94 8H6Z M13 8L11 91 M87 8L89 91 M6 91H94L100 99H0Z" />
                </svg>
                {pillarStars(idx).map(([x, y, s]) => (
                  <span class="cstar" style={`left:${x}%;top:${y}%;--s:${s}`} aria-hidden="true" />
                ))}

                <div class="pillar-shaft relative flex w-[78%] flex-1 flex-col items-center px-2 pt-14 pb-14 lg:pt-16 lg:pb-16">
                  <div class="pillar-icon mb-4 flex size-12 shrink-0 items-center justify-center rounded-full lg:size-14">
                    <Icon name={p.icon} class="size-6 lg:size-7" />
                  </div>
                  <h3 class="pillar-title font-heading text-sm leading-snug font-semibold sm:text-base lg:text-lg">
                    {p.title}
                  </h3>
                  <Button
                    variant="ghost"
                    arrow="right"
                    href={getLocalizedRoute(currLocale, `/capabilities/${p.slug}`)}
                    class="mt-auto px-2 pt-6 text-sm font-medium hover:bg-transparent lg:text-base"
                  >
                    Learn More <span class="sr-only">about {p.title}</span>
                  </Button>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- the steps the colonnade stands on: three starlit lines, widening toward the ground -->
      <div class="relative mt-1 hidden lg:block" aria-hidden="true">
        <svg class="block h-8 w-full" viewBox="0 0 100 12" preserveAspectRatio="none">
          <path class="temple-line" d="M4 2H96 M1.5 6H98.5 M0 10H100" />
        </svg>
        {STEP_STARS.map(([x, y, s]) => <span class="cstar" style={`left:${x}%;top:${(y / 12) * 100}%;--s:${s}`} />)}
      </div>
    </div>
  </div>
</section>

<style>
  /* constellation lines and stars, in the site's green; each column brightens with its own --focus */
  .temple-line,
  .pillar-line {
    fill: none;
    stroke-width: 1.2px;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .temple-line {
    stroke: color-mix(in srgb, #a7f3d0 45%, transparent);
  }
  .temple-dots {
    fill: none;
    stroke: color-mix(in srgb, #a7f3d0 35%, transparent);
    stroke-width: 1.4px;
    stroke-linecap: round;
    stroke-dasharray: 0 9;
    vector-effect: non-scaling-stroke;
  }
  .temple-glass {
    fill: color-mix(in srgb, #34d399 5%, transparent);
  }
  .pillar-line {
    stroke: color-mix(in srgb, #a7f3d0 calc(32% + var(--focus, 0) * 50%), transparent);
  }
  /* fluting as faint dotted star trails */
  .pillar-flute {
    fill: none;
    stroke: color-mix(in srgb, #a7f3d0 calc(14% + var(--focus, 0) * 26%), transparent);
    stroke-width: 1.3px;
    stroke-linecap: round;
    stroke-dasharray: 0 7;
    vector-effect: non-scaling-stroke;
  }
  /* glass between the shaft's edges, lit a little more in focus */
  .pillar-glass {
    fill: color-mix(in srgb, #34d399 calc(4% + var(--focus, 0) * 7%), transparent);
  }

  /* a star: a bright core with a green halo; --s scales it */
  .cstar {
    position: absolute;
    width: calc(3.2px * var(--s, 1));
    height: calc(3.2px * var(--s, 1));
    border-radius: 50%;
    background: #f0fff8;
    box-shadow:
      0 0 calc(3px * var(--s, 1)) rgba(255, 255, 255, 0.8),
      0 0 calc(10px * var(--s, 1)) calc(1.5px * var(--s, 1)) rgba(52, 211, 153, 0.45);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .pillar-column .cstar {
    opacity: calc(0.55 + var(--focus, 0) * 0.45);
    transition: opacity 0.15s ease;
  }

  /* the icon as the column's brightest star */
  .pillar-icon {
    color: #34d399;
    background: radial-gradient(circle, color-mix(in srgb, #34d399 22%, transparent) 0%, transparent 72%);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, #34d399 calc(25% + var(--focus, 0) * 35%), transparent),
      0 0 calc(var(--focus, 0) * 22px) color-mix(in srgb, #34d399 35%, transparent);
  }

  .pillar-shaft {
    min-height: 260px;
  }
  @media (min-width: 1024px) {
    .pillar-shaft {
      min-height: 360px;
    }
  }

  /* Continuous, independent-per-card focus driven by scroll position:
     each pillar brightens/lifts on its own as it nears a reference line,
     rather than a single shared "active" card. */
  .pillar-column {
    --focus: 0;
    /* light only, no scale: the columns have to keep holding up the roof */
    opacity: calc(0.6 + var(--focus, 0) * 0.4);
    filter: drop-shadow(0 0 calc(var(--focus, 0) * 18px) color-mix(in srgb, #34d399 30%, transparent));
    transition:
      opacity 0.15s ease,
      filter 0.15s ease;
  }
  .pillar-title {
    transition: color 0.15s ease;
    color: color-mix(in srgb, #34d399 calc(var(--focus, 0) * 100%), var(--color-foreground));
  }
</style>

<script>
  import { onScrollWhileNear } from "@/js/scrollUtils";

  // Each pillar gets its own continuous focus amount (0-1) based on how
  // close its center is to a reference line, independent of the others —
  // so it reads as fluid, per-card life rather than one shared spotlight.
  function initCapabilitiesFocus() {
    const list = document.querySelector<HTMLElement>("#capabilities-list");
    const items = Array.from(list?.querySelectorAll<HTMLElement>("[data-capability-index]") ?? []);
    if (!list || items.length === 0 || list.dataset.focusInit === "true") return;
    list.dataset.focusInit = "true";

    const falloff = 260; // px of distance over which focus fades from 1 to 0

    const wave = 70; // px offset per card, so the focus peak sweeps left to right
    const releaseAfter = 150; // px of scrolling after which a hover-picked pillar hands back to scroll focus

    // Hovering (or tabbing to) a pillar picks it: it alone stays lit, the
    // others dim, and it stays picked after the pointer leaves.
    let picked: HTMLElement | null = null;
    let pickedAtScroll = 0;

    function update() {
      if (picked && Math.abs(window.scrollY - pickedAtScroll) > releaseAfter) picked = null;

      const baseReferenceY = window.innerHeight * 0.55;

      items.forEach((item, i) => {
        if (picked) {
          item.style.setProperty("--focus", item === picked ? "1" : "0");
          return;
        }
        // Scrolling down moves mid from high to low; subtracting per-index
        // offset makes the leftmost card (i=0) cross its target first,
        // so the focus peak visibly sweeps left to right as you scroll.
        const referenceY = baseReferenceY - i * wave;
        const rect = item.getBoundingClientRect();
        const mid = rect.top + rect.height / 2;
        const distance = Math.abs(mid - referenceY);
        const focus = Math.max(0, 1 - distance / falloff);
        item.style.setProperty("--focus", focus.toFixed(3));
      });
    }

    function pick(item: HTMLElement) {
      picked = item;
      pickedAtScroll = window.scrollY;
      update();
    }

    items.forEach((item) => {
      // touch screens have no real hover; they keep the scroll-driven focus
      item.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") pick(item);
      });
      item.addEventListener("focusin", () => pick(item));
      // the whole pillar is clickable; it follows its Learn More link
      const link = item.querySelector<HTMLAnchorElement>("a[href]");
      item.addEventListener("click", (e) => {
        if (!link || (e.target as Element).closest("a")) return;
        if (e.metaKey || e.ctrlKey) window.open(link.href, "_blank");
        else link.click();
      });
    });

    update();
    if (list) onScrollWhileNear(list, update);
  }

  initCapabilitiesFocus();
  document.addEventListener("astro:after-swap", initCapabilitiesFocus);
</script>
