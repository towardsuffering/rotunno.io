---
import { Icon } from "astro-icon/components";

import Button from "@/components/button/Button.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getLocalizedRoute } from "@/js/translationUtils";

const currLocale = getLocaleFromUrl(Astro.url);

const pillars = [
  {
    icon: "tabler/users",
    title: "Empowering Others",
    slug: "empowering-others",
  },
  {
    icon: "tabler/briefcase",
    title: "Finding Structure",
    slug: "finding-structure",
  },
  {
    icon: "tabler/database",
    title: "Troubleshooting Systems",
    slug: "troubleshooting-systems",
  },
  {
    icon: "tabler/palette",
    title: "Predicting Patterns",
    slug: "predicting-patterns",
  },
];
---

<section id="capabilities-cards" class="my-12 py-12">
  <div class="site-container" id="capabilities-cards-trigger">
    <h2 class="h2 mx-auto max-w-3xl text-center" data-reveal="pop">Core Capabilities</h2>

    <div class="temple relative mx-auto mt-16 max-w-5xl">
      <!-- roof: pediment over the entablature (cornice, frieze, architrave) -->
      <div class="hidden lg:block" aria-hidden="true">
        <svg class="pediment block h-16 w-full" viewBox="0 0 100 10" preserveAspectRatio="none">
          <polygon points="0,10 50,0.6 100,10" vector-effect="non-scaling-stroke" />
        </svg>
        <div class="temple-cornice h-2.5 rounded-sm" />
        <div class="temple-frieze mx-3 h-4" />
        <div class="temple-architrave mx-5 h-2.5 rounded-b-sm" />
      </div>

      <div
        class="grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-8 lg:grid-cols-4 lg:gap-x-10 lg:px-10"
        id="capabilities-list"
      >
        {
          pillars.map((p, idx) => (
            <div class="flex justify-center" data-reveal="rise" data-reveal-delay={idx * 0.1}>
              <!-- the reveal animation owns this wrapper's transform; focus styles live on the inner column -->
              <div
                class="pillar-column flex w-full max-w-[230px] cursor-pointer flex-col items-center text-center"
                data-capability-index={idx}
              >
                <!-- Ionic capital: abacus slab, volutes scrolling off an echinus, astragal ring at the neck -->
                <div class="flex w-full flex-col items-center" aria-hidden="true">
                  <div class="pillar-abacus h-2.5 w-full rounded-sm" />
                  <div class="flex h-6 w-full items-start">
                    <svg class="pillar-volute size-6 shrink-0" viewBox="0 0 24 24">
                      <path d="M12 12 A1.5 1.5 0 0 1 15 12 A3 3 0 0 1 9 12 A4.5 4.5 0 0 1 18 12 A6 6 0 0 1 6 12 A6.5 6.5 0 0 1 12 1" />
                    </svg>
                    <div class="pillar-echinus h-3.5 flex-1 rounded-b-[50%]" />
                    <svg class="pillar-volute size-6 shrink-0 -scale-x-100" viewBox="0 0 24 24">
                      <path d="M12 12 A1.5 1.5 0 0 1 15 12 A3 3 0 0 1 9 12 A4.5 4.5 0 0 1 18 12 A6 6 0 0 1 6 12 A6.5 6.5 0 0 1 12 1" />
                    </svg>
                  </div>
                  <div class="pillar-astragal h-1.5 w-[80%] rounded-full" />
                </div>

                <!-- fluted shaft with a slight entasis taper toward the top -->
                <div class="pillar-shaft flex w-[78%] flex-1 flex-col items-center px-2 pt-8 pb-10 lg:pt-10 lg:pb-14">
                  <div
                    class="mb-4 flex size-12 shrink-0 items-center justify-center rounded-full lg:size-14"
                    style="background: color-mix(in srgb, #34d399 15%, var(--color-background)); color: #34d399;"
                  >
                    <Icon name={p.icon} class="size-6 lg:size-7" />
                  </div>
                  <h3 class="pillar-title font-heading text-sm leading-snug font-semibold sm:text-base lg:text-lg">
                    {p.title}
                  </h3>
                  <Button
                    variant="ghost"
                    arrow="right"
                    href={getLocalizedRoute(currLocale, `/capabilities/${p.slug}`)}
                    class="mt-auto px-2 pt-6 text-sm font-medium hover:bg-transparent lg:text-base"
                  >
                    Learn More <span class="sr-only">about {p.title}</span>
                  </Button>
                </div>

                <!-- Attic base: torus, scotia, torus, plinth -->
                <div class="flex w-full flex-col items-center" aria-hidden="true">
                  <div class="pillar-torus h-2 w-[86%] rounded-full" />
                  <div class="pillar-scotia h-1 w-[80%]" />
                  <div class="pillar-torus h-2.5 w-[94%] rounded-full" />
                  <div class="pillar-plinth h-2.5 w-full rounded-sm" />
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- stylobate: the stepped platform the colonnade stands on -->
      <div class="hidden lg:block" aria-hidden="true">
        <div class="temple-step mx-4 h-2.5" />
        <div class="temple-step mx-1 h-2.5" />
        <div class="temple-step -mx-2 h-2.5 rounded-b-sm" />
      </div>
    </div>
  </div>
</section>

<style>
  /* stone tones: the site's green, mixed into the background */
  .temple {
    --stone: color-mix(in srgb, #34d399 24%, var(--color-background));
    --stone-light: color-mix(in srgb, #34d399 34%, var(--color-background));
    --stone-dark: color-mix(in srgb, #34d399 14%, var(--color-background));
  }

  .pediment polygon {
    fill: color-mix(in srgb, #34d399 7%, var(--color-background));
    stroke: color-mix(in srgb, #34d399 45%, transparent);
    stroke-width: 1.5px;
  }
  .temple-cornice,
  .temple-architrave {
    background: var(--stone);
  }
  /* frieze: triglyph-like grooves between the cornice and architrave */
  .temple-frieze {
    background:
      repeating-linear-gradient(90deg, var(--stone-light) 0 3px, transparent 3px 6px, var(--stone-light) 6px 9px, transparent 9px 44px),
      var(--stone-dark);
  }
  .temple-step {
    background: var(--stone-dark);
    border-top: 1px solid var(--stone-light);
  }

  .pillar-abacus,
  .pillar-plinth {
    background: var(--stone-light);
  }
  .pillar-echinus,
  .pillar-torus {
    background: var(--stone);
  }
  .pillar-astragal {
    background: var(--stone-light);
  }
  .pillar-scotia {
    background: var(--stone-dark);
  }
  .pillar-volute {
    fill: none;
    stroke: var(--stone-light);
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  /* fluting (vertical grooves) over cylinder shading (dark edges, lit middle);
     the flutes and light both rise with focus */
  .pillar-shaft {
    min-height: 260px;
    clip-path: polygon(4% 0, 96% 0, 100% 100%, 0 100%);
    background:
      repeating-linear-gradient(
        90deg,
        color-mix(in srgb, #34d399 calc(14% + var(--focus, 0) * 14%), transparent) 0 1px,
        transparent 1px 12%
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, #34d399 6%, var(--color-background)) 0%,
        color-mix(in srgb, #34d399 calc(12% + var(--focus, 0) * 10%), var(--color-background)) 40%,
        color-mix(in srgb, #34d399 calc(10% + var(--focus, 0) * 8%), var(--color-background)) 60%,
        color-mix(in srgb, #34d399 4%, var(--color-background)) 100%
      );
  }
  @media (min-width: 1024px) {
    .pillar-shaft {
      min-height: 360px;
    }
  }

  /* Continuous, independent-per-card focus driven by scroll position:
     each pillar brightens/lifts on its own as it nears a reference line,
     rather than a single shared "active" card. */
  .pillar-column {
    --focus: 0;
    /* light only, no scale: the columns have to keep holding up the roof */
    opacity: calc(0.6 + var(--focus, 0) * 0.4);
    filter: drop-shadow(0 0 calc(var(--focus, 0) * 18px) color-mix(in srgb, #34d399 30%, transparent));
    transition:
      opacity 0.15s ease,
      filter 0.15s ease;
  }
  .pillar-title {
    transition: color 0.15s ease;
    color: color-mix(in srgb, #34d399 calc(var(--focus, 0) * 100%), var(--color-foreground));
  }
</style>

<script>
  // Each pillar gets its own continuous focus amount (0-1) based on how
  // close its center is to a reference line, independent of the others —
  // so it reads as fluid, per-card life rather than one shared spotlight.
  function initCapabilitiesFocus() {
    const list = document.querySelector<HTMLElement>("#capabilities-list");
    const items = Array.from(list?.querySelectorAll<HTMLElement>("[data-capability-index]") ?? []);
    if (!list || items.length === 0 || list.dataset.focusInit === "true") return;
    list.dataset.focusInit = "true";

    const falloff = 260; // px of distance over which focus fades from 1 to 0

    const wave = 70; // px offset per card, so the focus peak sweeps left to right
    const releaseAfter = 150; // px of scrolling after which a hover-picked pillar hands back to scroll focus

    // Hovering (or tabbing to) a pillar picks it: it alone stays lit, the
    // others dim, and it stays picked after the pointer leaves.
    let picked: HTMLElement | null = null;
    let pickedAtScroll = 0;

    function update() {
      if (picked && Math.abs(window.scrollY - pickedAtScroll) > releaseAfter) picked = null;

      const baseReferenceY = window.innerHeight * 0.55;

      items.forEach((item, i) => {
        if (picked) {
          item.style.setProperty("--focus", item === picked ? "1" : "0");
          return;
        }
        // Scrolling down moves mid from high to low; subtracting per-index
        // offset makes the leftmost card (i=0) cross its target first,
        // so the focus peak visibly sweeps left to right as you scroll.
        const referenceY = baseReferenceY - i * wave;
        const rect = item.getBoundingClientRect();
        const mid = rect.top + rect.height / 2;
        const distance = Math.abs(mid - referenceY);
        const focus = Math.max(0, 1 - distance / falloff);
        item.style.setProperty("--focus", focus.toFixed(3));
      });
    }

    function pick(item: HTMLElement) {
      picked = item;
      pickedAtScroll = window.scrollY;
      update();
    }

    items.forEach((item) => {
      // touch screens have no real hover; they keep the scroll-driven focus
      item.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") pick(item);
      });
      item.addEventListener("focusin", () => pick(item));
      // the whole pillar is clickable; it follows its Learn More link
      const link = item.querySelector<HTMLAnchorElement>("a[href]");
      item.addEventListener("click", (e) => {
        if (!link || (e.target as Element).closest("a")) return;
        if (e.metaKey || e.ctrlKey) window.open(link.href, "_blank");
        else link.click();
      });
    });

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }

  initCapabilitiesFocus();
  document.addEventListener("astro:after-swap", initCapabilitiesFocus);
</script>
