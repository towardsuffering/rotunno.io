---
import deeperQuestionImage from "@images/faq/deeper-question.jpg";
import { Image } from "astro:assets";

import { getLocaleFromUrl } from "@/js/localeUtils";
import { getTranslatedData } from "@/js/translationUtils";

import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from "./accordion-small";

const currLocale = getLocaleFromUrl(Astro.url);
const faqData = getTranslatedData("faqData", currLocale);
---

<section class="overflow-hidden py-16 md:py-24">
  <div class="site-container">
    <div class="grid gap-8 md:grid-cols-2 md:gap-16">
      <!-- Left Side - FAQ Content -->
      <div class="flex h-full flex-col" data-reveal="blur-left">
        <div class="md:max-w-lg">
          <h2 class="text-foreground h2 mb-4">Frequently Asked Questions</h2>
          <p class="description mr-auto mb-8 max-w-sm">
            Can't find what you're looking for? Reach out through the contact form below.
          </p>
        </div>

        <div class="mt-6 flex flex-col gap-3" id="faq-list">
          <Accordion class="space-y-1">
            {
              faqData.map((faqItem, idx) => (
                <AccordionItem
                  value={`item-${idx}`}
                  class="border-border border-b-2 pb-1"
                  data-faq-index={idx}
                >
                  <AccordionTrigger class="font-heading px-0 py-4 text-lg font-semibold">
                    {faqItem.question}
                  </AccordionTrigger>
                  <AccordionContent class="text-muted-foreground px-0" details={faqItem.answer} />
                </AccordionItem>
              ))
            }
          </Accordion>

        </div>
      </div>

      <!-- Right Side - branded panel -->
      <div class="order-first flex md:order-last" data-reveal="pop">
        <div
          class="relative h-80 w-full overflow-hidden rounded-2xl md:h-full flex flex-col items-center justify-center gap-4 px-8 text-center"
        >
          <Image
            src={deeperQuestionImage}
            alt=""
            class="absolute inset-0 -z-10 h-full w-full object-cover object-[center_30%] md:object-center"
          />
          <div class="absolute inset-0 -z-10 bg-black/50"></div>
          <p class="font-heading text-3xl font-semibold text-white leading-snug">
            Looking for something deeper?
          </p>
          <p class="text-white/60 text-base max-w-xs">
            Dig a little more, ask me!
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  #faq-list .starwind-accordion-item {
    --focus: 0;
    opacity: calc(0.45 + var(--focus) * 0.55);
    transform: scale(calc(0.94 + var(--focus) * 0.06));
    background: color-mix(in srgb, #34d399 calc(var(--focus) * 10%), transparent);
    border-color: color-mix(in srgb, #34d399 calc(var(--focus) * 45%), transparent);
    border-radius: 0.5rem;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease;
  }
  #faq-list .starwind-accordion-item .starwind-accordion-trigger {
    transition: color 0.15s ease;
    color: color-mix(in srgb, #34d399 calc(var(--focus) * 100%), var(--color-foreground));
  }
</style>

<script>
  // Each question gets its own continuous focus amount (0-1) based on how
  // close its center is to a reference line, rather than one shared
  // "active index" — so it reads as smooth, independent fluidity per
  // item instead of a single spotlight that has to jump discretely.
  function initFaqFocus() {
    const list = document.querySelector<HTMLElement>("#faq-list");
    const items = Array.from(list?.querySelectorAll<HTMLElement>("[data-faq-index]") ?? []);
    if (!list || items.length === 0 || list.dataset.focusInit === "true") return;
    list.dataset.focusInit = "true";

    const falloff = 220; // px of distance over which focus fades from 1 to 0

    function update() {
      const referenceY = window.innerHeight * 0.45;

      items.forEach((item) => {
        const rect = item.getBoundingClientRect();
        const mid = rect.top + rect.height / 2;
        const distance = Math.abs(mid - referenceY);
        const focus = Math.max(0, 1 - distance / falloff);
        item.style.setProperty("--focus", focus.toFixed(3));
      });
    }

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }

  initFaqFocus();
  document.addEventListener("astro:after-swap", initFaqFocus);
</script>
