---
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getLocalizedRoute, getTranslatedData, useTranslations } from "@/js/translationUtils";

const currLocale = getLocaleFromUrl(Astro.url);
const t = useTranslations(currLocale);

interface StatItem {
  value: string;
  label: string;
}

const stats: StatItem[] = [
  {
    value: "10+",
    label: "Professional References",
  },
  {
    value: "100K+",
    label: "Satisfied Customers",
  },
  {
    value: "25+",
    label: "People Led",
  },
  {
    value: "$50M+",
    label: "in Sales",
  },
];
---

<section class="relative overflow-hidden px-4 py-12 md:py-16">
  <div class="site-container relative overflow-hidden rounded-xl py-6 md:rounded-2xl md:py-12">
    <div
      class="from-primary-700 to-primary-500 dark:from-primary-900 dark:to-primary-700 absolute inset-0 z-0 bg-gradient-to-r"
    >
    </div>
    <div class="site-container relative z-10">
      <div
        id="about-numbers-trigger"
        class="lg:divide-base-200 grid grid-cols-2 gap-6 text-center lg:grid-cols-4 lg:gap-0 lg:divide-x"
      >
        {
          stats.map((stat, index) => (
            <div
              class="font-heading space-y-1.5 py-10 font-semibold md:px-4 lg:px-2 xl:px-4"
              data-mos="fade-up"
              data-mos-anchor="#about-numbers-trigger"
              data-mos-delay={index * 0.15}
            >
              <p class="stat-number text-base-50 text-3xl sm:text-5xl lg:text-4xl xl:text-6xl">
                {stat.value}
              </p>
              <p class="text-base-50 text-base sm:text-lg lg:text-base xl:text-xl">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .stat-number {
    display: inline-block;
  }
</style>

<script>
  const CHARS = "0123456789";

  // Numbers spin (random digits) for as long as the user is actively
  // scrolling while this section is in view, then lock back in to the
  // real value shortly after scrolling stops — rather than a one-shot
  // reveal animation that only plays once.
  function initSpinNumbers() {
    const numbers = document.querySelectorAll<HTMLElement>(".stat-number");
    const container = document.querySelector<HTMLElement>("#about-numbers-trigger");
    if (!container || container.dataset.spinInit === "true") return;
    container.dataset.spinInit = "true";

    numbers.forEach((el) => {
      el.dataset.final = el.textContent ?? "";
    });

    let isVisible = false;
    let spinInterval: ReturnType<typeof setInterval> | null = null;
    let settleTimeout: ReturnType<typeof setTimeout> | null = null;

    function randomizeAll() {
      numbers.forEach((el) => {
        const final = el.dataset.final!;
        el.textContent = final.replace(
          /[0-9]/g,
          () => CHARS[Math.floor(Math.random() * CHARS.length)],
        );
      });
    }

    function lockIn() {
      numbers.forEach((el) => {
        el.textContent = el.dataset.final!;
      });
    }

    function stopSpin() {
      if (spinInterval) {
        clearInterval(spinInterval);
        spinInterval = null;
      }
    }

    function startSpin() {
      if (spinInterval || !isVisible) return;
      spinInterval = setInterval(randomizeAll, 60);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (!isVisible) {
            stopSpin();
            lockIn();
          }
        });
      },
      { threshold: 0.1 },
    );
    observer.observe(container);

    window.addEventListener(
      "scroll",
      () => {
        if (isVisible) startSpin();

        if (settleTimeout) clearTimeout(settleTimeout);
        settleTimeout = setTimeout(() => {
          stopSpin();
          lockIn();
        }, 150);
      },
      { passive: true },
    );
  }

  initSpinNumbers();
  document.addEventListener("astro:after-swap", initSpinNumbers);
</script>
