---
import chris from "@images/chris.jpg";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import Badge from "../badge/Badge.astro";

const pillars = [
  {
    icon: "tabler/users",
    title: "People, not platforms",
    desc: "A sharp read on behavior and psychology, the kind that generates leads and earns buy-in without a social following to lean on.",
  },
  {
    icon: "tabler/briefcase",
    title: "Organizational fluency",
    desc: "I map the real chain of command fast: who decides, who influences, and where the structure itself is costing efficiency.",
  },
  {
    icon: "tabler/database",
    title: "Technical depth",
    desc: "Well beyond Office: I've supported centralized, high-level operations at international bank scale.",
  },
];
---

<section id="team-swiper" class="py-12 lg:py-16">
  <div class="site-container">
    <!-- Two-column grid: text | photo -->
    <div class="grid items-center gap-8 md:grid-cols-2 md:gap-16" id="team-trigger">
      <!-- Col 1: text -->
      <div class="flex flex-col gap-4" data-mos="fade-right" data-mos-anchor="#team-trigger">
        <Badge>About Me</Badge>
        <h3 class="text-foreground h2">Christopher A. Rotunno</h3>
        <p class="text-primary-accent font-heading font-semibold md:text-lg">
          Analytics engineer & BI leader, building the systems that turn fragmented data into
          decisions people actually act on.
        </p>
        <ul class="mt-1 flex flex-col gap-3">
          {
            pillars.map((p) => (
              <li class="flex items-start gap-3">
                <span class="bg-primary-accent/10 text-primary-accent mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full">
                  <Icon name={p.icon} class="size-4" />
                </span>
                <span>
                  <span class="text-foreground font-semibold">{p.title}.</span>{" "}
                  <span class="text-muted-foreground">{p.desc}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <div class="flex flex-wrap gap-2">
          {
            ["Analytics", "Retail", "Food Service", "Home Improvement"].map((tag) => (
              <span class="border-primary-accent/30 text-primary-accent bg-primary-accent/10 rounded-full border px-3 py-1 text-xs font-semibold tracking-wide uppercase">
                {tag}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Col 2: photo -->
      <div
        class="flex flex-col items-start text-left"
        data-mos="fade-left"
        data-mos-anchor="#team-trigger"
        data-mos-delay=".15"
      >
        <div class="founder-card mb-4 aspect-[7/8] w-full overflow-hidden rounded-xl shadow-md">
          <Image
            src={chris}
            alt="Portrait of Christopher A. Rotunno"
            width={400}
            densities={[1.5, 2]}
            class="founder-photo h-full w-full object-cover"
          />
        </div>
        <span class="text-primary-accent text-lg font-semibold">Christopher A. Rotunno</span>
        <p class="text-muted-foreground mt-1 text-sm font-semibold">
          Data Analytics Engineer & BI Leader
        </p>
        <p class="mt-2 text-sm">
          Remote-first, ideally with a global team. Open to hybrid, or relocating anywhere in the
          US for the right role: one with compensation and benefits strong enough to meet my
          financial obligations, and the balance to sustain the work I put in.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .founder-card {
    transition:
      box-shadow 0.4s ease,
      transform 0.4s ease;
  }
  .founder-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
  }
  .founder-photo {
    transition:
      transform 0.6s ease,
      filter 0.4s ease;
  }
  .founder-card:hover .founder-photo {
    transform: scale(1.04);
    filter: brightness(1.05) contrast(1.05);
  }
</style>
