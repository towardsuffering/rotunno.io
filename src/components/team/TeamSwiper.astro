---
import chris from "@images/chris-avatar.jpg";
import { Image } from "astro:assets";

import Badge from "../badge/Badge.astro";

const badgeText = "Super Intelligence Leader";
const preText = ", building toward systems that turn ";
// Everything from "fragmented" onward explodes into shards; nothing before it does.
const shardText = "fragmented tidbits into confidence.";

// Deterministic scattered starting position for each character, so this
// whole tail reads as shattered fragments that assemble into place as it
// scrolls into view (and scatter back apart scrolling back out). Spaces are
// kept as plain text (not spans) so word gaps and wrapping stay normal.
// "confidence" gets its own treatment: it scales in from oversized down
// to normal instead of scattering/rotating like the rest of the shards.
const confidenceStart = shardText.indexOf("confidence");
const confidenceEnd = confidenceStart + "confidence".length;

const shardChars = shardText.split("").map((ch, i) => {
  const isConfidence = i >= confidenceStart && i < confidenceEnd;
  const style = isConfidence
    ? `--shard-scale:${(1.6 + ((i - confidenceStart) % 3) * 0.2).toFixed(1)};`
    : `--shard-x:${((i * 47) % 37) - 18}px;--shard-y:${((i * 83) % 37) - 18}px;--shard-rot:${((i * 61) % 101) - 50}deg;`;
  return { ch, index: i, isSpace: ch === " ", isConfidence, style };
});
// group letters into words so the line only wraps between words, never mid-word
const shardWords = shardChars.reduce<(typeof shardChars)[]>(
  (words, c) => {
    if (c.isSpace) words.push([]);
    else words[words.length - 1].push(c);
    return words;
  },
  [[]],
);
---

<section id="team-swiper" class="px-4 py-12 lg:py-16">
  <div class="site-container">
    <div
      class="about-card relative mx-auto max-w-4xl overflow-hidden rounded-3xl border p-6 shadow-md md:p-10"
      id="team-trigger"
    >
      <!-- Two-column grid: text | photo -->
      <div class="grid items-center gap-8 md:grid-cols-[1fr_auto] md:gap-8">
        <!-- Col 1: text -->
        <div class="flex flex-col gap-4" data-mos="fade-right" data-mos-anchor="#team-trigger">
          <Badge>About Me</Badge>
          <h3 class="text-foreground h2">Christopher A. Rotunno</h3>
          <p class="text-lg font-heading font-semibold leading-snug md:text-2xl" style="color: #34d399;">
            <span class="typewriter-group"
              ><span class="rounded-md px-1.5 py-0.5" style="background: #34d399; color: #0f172a;"
                ><span class="tw-slice" data-text={badgeText} data-role="badge"
                  ><span class="sr-only">{badgeText}</span
                  ><span class="tw-slice-visible" aria-hidden="true"></span
                  ></span
                ></span
              ><span class="tw-slice" data-text={preText} data-role="pre"
                ><span class="sr-only">{preText}</span
                ><span class="tw-slice-visible" aria-hidden="true"></span
                ></span
              ><span class="tw-shard-word" data-role="shard" data-length={shardText.length}
                ><span class="sr-only">{shardText}</span
                ><span aria-hidden="true"
                  >{shardWords.map((word) => (
                    // kept on one line: any whitespace in here would survive minification as stray spaces
                    <span class="tw-word">{word.map((c) => <span class:list={["tw-char", { "tw-scale": c.isConfidence }]} data-index={c.index} style={c.style}>{c.ch}</span>)}</span>
                  ))}</span
                ></span
              ></span
            >
          </p>
        </div>

        <!-- Col 2: photo -->
        <div
          class="flex justify-center md:justify-start"
          data-mos="fade-left"
          data-mos-anchor="#team-trigger"
          data-mos-delay=".15"
        >
          <div class="photo-frame relative w-[240px] max-w-full">
            <div class="photo-backdrop absolute -inset-3 -z-10 rounded-2xl" aria-hidden="true">
            </div>
            <div class="founder-card aspect-square w-full overflow-hidden rounded-full shadow-lg">
              <Image
                src={chris}
                alt="Portrait of Christopher A. Rotunno"
                width={360}
                densities={[1.5, 2]}
                class="founder-photo h-full w-full object-cover"
              />
            </div>

            <div class="status-chip mt-4 flex items-center gap-2 rounded-full border px-4 py-2">
              <span class="flex size-4 shrink-0 items-center justify-center">
                <span class="status-dot size-2 rounded-full"></span>
              </span>
              <span class="text-foreground text-xs font-medium">
                Open to AI roles — remote or hybrid, global team preferred
              </span>
            </div>

            <div class="status-chip mt-2 flex items-center gap-2 rounded-full border px-4 py-2">
              <span class="flex size-4 shrink-0 items-center justify-center text-sm leading-none" aria-hidden="true">🎓</span>
              <span class="text-foreground text-xs font-medium">
                Prioritizing employers that offer student loan repayment benefits and stock options
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-card {
    background: color-mix(in srgb, #34d399 4%, var(--color-background));
    border-color: color-mix(in srgb, #34d399 20%, transparent);
  }

  .status-chip {
    background: color-mix(in srgb, #34d399 8%, var(--color-background));
    border-color: color-mix(in srgb, #34d399 30%, transparent);
  }
  .status-dot {
    background: #34d399;
    box-shadow: 0 0 0 3px color-mix(in srgb, #34d399 25%, transparent);
    animation: status-pulse 2s ease-in-out infinite;
  }
  @keyframes status-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .photo-backdrop {
    background: color-mix(in srgb, #34d399 25%, transparent);
    transform: rotate(-3deg);
  }

  .founder-card {
    border: 1px solid color-mix(in srgb, #34d399 30%, transparent);
    transition:
      box-shadow 0.4s ease,
      transform 0.4s ease;
  }
  .founder-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
  }
  .founder-photo {
    transition:
      transform 0.6s ease,
      filter 0.4s ease;
  }
  .founder-card:hover .founder-photo {
    transform: scale(1.04);
    filter: brightness(1.05) contrast(1.05);
  }

  /* inline-block words with margin spacing: wraps only between words and survives HTML minification,
     which moves text-node spaces inside the word wrappers */
  .tw-word {
    display: inline-block;
    white-space: nowrap;
  }
  /* space after each word (not before), so a word that wraps to a new line starts flush left */
  .tw-word:not(:last-child) {
    margin-right: 0.28em;
  }
  .tw-char {
    display: inline-block;
    opacity: 0;
    filter: blur(1px);
    transform: translate(var(--shard-x, 0), var(--shard-y, 0)) rotate(var(--shard-rot, 0deg));
    transition:
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.35s ease,
      filter 0.35s ease;
  }
  .tw-char.is-revealed {
    opacity: 1;
    filter: none;
    transform: none;
  }

  .tw-char.tw-scale {
    transform: scale(var(--shard-scale, 3));
    filter: none;
    /* theme-aware: white glow on dark, dark text with a soft glow on light */
    color: var(--color-foreground);
    text-shadow: 0 0 12px color-mix(in srgb, var(--color-foreground) 45%, transparent);
    /* quick, no-overshoot settle so the word snaps in rather than wobbling */
    transition:
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.2s ease;
  }
  .tw-char.tw-scale.is-revealed {
    transform: scale(1);
  }
</style>

<script>
  // Ties the number of revealed characters across the whole sentence to
  // how far it has scrolled through a fixed band of the viewport, so it
  // types in scrolling down and un-types scrolling back up. The word
  // "fragmented" is rendered letter-by-letter starting scattered and
  // rotated (shards), snapping into place as its letters get revealed.
  function initTypewriter() {
    const groups = document.querySelectorAll<HTMLElement>(".typewriter-group");
    groups.forEach((group) => {
      if (group.dataset.twInit === "true") return;
      group.dataset.twInit = "true";

      const badgeEl = group.querySelector<HTMLElement>('[data-role="badge"]');
      const preEl = group.querySelector<HTMLElement>('[data-role="pre"]');
      const shardEl = group.querySelector<HTMLElement>('[data-role="shard"]');
      const badgeVisible = badgeEl?.querySelector<HTMLElement>(".tw-slice-visible");
      const preVisible = preEl?.querySelector<HTMLElement>(".tw-slice-visible");
      if (!badgeEl || !preEl || !shardEl || !badgeVisible || !preVisible) {
        return;
      }

      const badgeVisibleEl: HTMLElement = badgeVisible;
      const preVisibleEl: HTMLElement = preVisible;

      const badgeText = badgeEl.dataset.text || "";
      const preText = preEl.dataset.text || "";
      const shardLetters = Array.from(shardEl.querySelectorAll<HTMLElement>(".tw-char"));
      const shardLen = parseInt(shardEl.dataset.length || "0", 10);
      const total = badgeText.length + preText.length + shardLen;
      let lastRevealed = -1;

      function update() {
        const rect = group.getBoundingClientRect();
        const vh = window.innerHeight;
        // finish by mid-screen so the last word ("confidence") lands while it's still in easy view
        const startY = vh * 0.95;
        const endY = vh * 0.55;
        let progress = (startY - rect.top) / (startY - endY);
        progress = Math.max(0, Math.min(1, progress));
        const revealed = Math.round(progress * total);
        if (revealed === lastRevealed) return;
        lastRevealed = revealed;

        let r = revealed;

        const badgeCount = Math.max(0, Math.min(badgeText.length, r));
        badgeVisibleEl.textContent = badgeText.slice(0, badgeCount);
        r -= badgeText.length;

        const preCount = Math.max(0, Math.min(preText.length, r));
        preVisibleEl.textContent = preText.slice(0, preCount);
        r -= preText.length;

        const shardCount = Math.max(0, Math.min(shardLen, r));
        shardLetters.forEach((letter) => {
          const idx = parseInt(letter.dataset.index || "0", 10);
          letter.classList.toggle("is-revealed", idx < shardCount);
        });
      }

      update();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
    });
  }

  initTypewriter();
  document.addEventListener("astro:after-swap", initTypewriter);
</script>
