---
export const prerender = true;
import { type InferGetStaticPropsType } from "astro";
import { render } from "astro:content";

import ExternalLink from "@/components/markdown-components/ExternalLink.astro";
import { defaultLocale } from "@/config/siteSettings.json";
import { getAllPosts } from "@/js/blogUtils";
import { postNotebookHeadings } from "@/js/notebookUtils";
import BlogLayoutCenter from "@/layouts/BlogLayoutCenter.astro";
import BlogLayoutSidebar from "@/layouts/BlogLayoutSidebar.astro";

export async function getStaticPaths() {
  const posts = await getAllPosts(defaultLocale);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const post = Astro.props as Props;
const { Content, headings } = await render(post);
// a post built from a notebook gets the notebook's headings in its table of contents too
const allHeadings = [...headings, ...postNotebookHeadings(post.filePath)];
---

<BlogLayoutSidebar post={post} headings={allHeadings}>
  <Content components={{ a: ExternalLink }} />
</BlogLayoutSidebar>
