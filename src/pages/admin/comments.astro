---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Comment moderation" description="Private comment moderation." noindex={true} fullHeight={false}>
  <section class="site-container pt-32 pb-24 md:pt-36">
    <div class="mx-auto max-w-3xl">
      <h1 class="h2">Comment moderation</h1>
      <p class="text-muted-foreground mt-2 text-sm">
        Enter the admin token (the <code>ENGAGEMENT_ADMIN_TOKEN</code> value set in Netlify). It is kept only in this
        browser tab.
      </p>

      <form class="mt-6 flex gap-2" data-login>
        <input
          type="password"
          name="token"
          placeholder="Admin token"
          class="flex-1 rounded-md border bg-transparent px-3 py-2"
          autocomplete="off"
        />
        <button class="button button--primary min-w-0 px-4 py-2 text-sm" type="submit">Load comments</button>
      </form>
      <p class="text-muted-foreground mt-3 text-sm" data-status role="status"></p>
      <div class="mt-8 flex flex-col gap-10" data-posts></div>
    </div>
  </section>
</BaseLayout>

<script>
  const API = "/api/engagement";
  type Comment = { id: string; name: string; emoji: string; text: string; createdAt: string };

  function init() {
    const login = document.querySelector<HTMLFormElement>("[data-login]");
    if (!login || login.dataset.ready) return;
    login.dataset.ready = "true";
    const status = document.querySelector<HTMLElement>("[data-status]")!;
    const posts = document.querySelector<HTMLElement>("[data-posts]")!;
    let token = sessionStorage.getItem("engagement-admin") ?? "";

    async function load() {
      status.textContent = "Loading...";
      const r = await fetch(`${API}?admin=1`, { headers: { "x-admin-token": token } }).catch(() => null);
      if (!r || !r.ok) {
        status.textContent = r?.status === 401 ? "Wrong token." : "Could not reach the API.";
        return;
      }
      sessionStorage.setItem("engagement-admin", token);
      const { posts: data } = (await r.json()) as { posts: { slug: string; comments: Comment[] }[] };
      const total = data.reduce((n, p) => n + p.comments.length, 0);
      status.textContent = `${total} comment${total === 1 ? "" : "s"} across ${data.length} post${data.length === 1 ? "" : "s"}.`;
      posts.replaceChildren(
        ...data.map((p) => {
          const wrap = document.createElement("div");
          const h = document.createElement("a");
          h.href = `/blog/${p.slug}/`;
          h.className = "font-semibold underline underline-offset-2";
          h.textContent = p.slug;
          const ul = document.createElement("ul");
          ul.className = "mt-3 flex flex-col gap-3";
          [...p.comments].reverse().forEach((c) => {
            const li = document.createElement("li");
            li.className = "flex items-start justify-between gap-4 rounded-lg border p-3";
            const body = document.createElement("div");
            const meta = document.createElement("div");
            meta.className = "text-sm font-semibold";
            meta.textContent = `${c.emoji} ${c.name} · ${new Date(c.createdAt).toLocaleString()}`;
            const text = document.createElement("p");
            text.className = "text-muted-foreground mt-1 text-sm whitespace-pre-line";
            text.textContent = c.text;
            body.append(meta, text);
            const del = document.createElement("button");
            del.className = "shrink-0 rounded-md border px-3 py-1 text-sm hover:border-red-500 hover:text-red-500";
            del.textContent = "Delete";
            del.addEventListener("click", async () => {
              if (!confirm(`Delete this comment by ${c.name}?`)) return;
              const res = await fetch(API, {
                method: "DELETE",
                headers: { "content-type": "application/json", "x-admin-token": token },
                body: JSON.stringify({ slug: p.slug, id: c.id }),
              });
              if (res.ok) li.remove();
              else alert("Delete failed.");
            });
            li.append(body, del);
            ul.append(li);
          });
          wrap.append(h, ul);
          return wrap;
        }),
      );
    }

    login.addEventListener("submit", (e) => {
      e.preventDefault();
      token = String(new FormData(login).get("token") ?? "");
      load();
    });
    if (token) load();
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
