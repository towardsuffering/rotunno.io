---
import "@/styles/global.css";

import type { ComponentProps } from "astro/types";
import { type CollectionEntry } from "astro:content";

import Footer from "@/components/footer/Footer.astro";
import Nav from "@/components/nav/Nav.astro";
import siteSettings from "@/config/siteSettings.json";
import { getLocaleFromUrl } from "@/js/localeUtils";
import BaseHead from "@/layouts/BaseHead.astro";

// heroImage and authorData are defined on blog posts
// authorData could also be defined on the about author page
interface Props extends ComponentProps<typeof Nav> {
  type?: "blog" | "general";
  title: string;
  description: string;
  image?: ImageMetadata;
  authorsData?: CollectionEntry<"authors">[];
  postFrontmatter?: CollectionEntry<"blog">["data"];
  noindex?: boolean; // you need to opt-in to no indexing, as it hides the page from search engines
  // set false on short pages so a sticky footer doesn't leave a large empty gap above it
  fullHeight?: boolean;
}

const {
  type = "general",
  title,
  description,
  image,
  authorsData,
  postFrontmatter,
  noindex = false,
  fullHeight = true,
  ...navProps
} = Astro.props as Props;

const currLocale = getLocaleFromUrl(Astro.url);
---

<!doctype html>
<html lang={currLocale} transition:animate="fade">
  <head>
    <BaseHead
      type={type}
      title={title}
      description={description}
      image={image ? image : undefined}
      authors={authorsData ? authorsData : undefined}
      postFrontmatter={postFrontmatter ? postFrontmatter : undefined}
      noindex={noindex}
    />
  </head>
  <body id="body" class={` ${siteSettings.useAnimations === true ? "use-animations" : ""}`}>
    <div id="page" class="">

      <Nav {...navProps} />
      <main class:list={["relative overflow-x-clip", { "min-h-[100lvh]": fullHeight }]}>
        <slot />
      </main>
      <Footer />
    </div>

    <!-- Custom reveal animations -->
    <script>
      function initReveal() {
        const els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        const timers = new Map<Element, ReturnType<typeof setTimeout>>();
        const io = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            const el = entry.target as HTMLElement;
            if (entry.isIntersecting) {
              const delay = parseFloat(el.dataset.revealDelay || '0') * 1000;
              const t = setTimeout(() => el.classList.add('revealed'), delay);
              timers.set(el, t);
            } else {
              clearTimeout(timers.get(el));
              timers.delete(el);
              el.classList.remove('revealed');
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => io.observe(el));
      }
      initReveal();
      document.addEventListener('astro:after-swap', initReveal);
    </script>

    <!-- Scroll animations: lightweight replacement for motion-on-scroll (same data-mos attributes) -->
    <script>
      import { siteSettings } from "@/config/siteSettings.json";

      function initScrollAnimations() {
        const els = [...document.querySelectorAll<HTMLElement>("[data-mos]:not(.mos-animate)")];
        if (!els.length) return;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (siteSettings.useAnimations !== true || reduce || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("mos-animate"));
          return;
        }
        // an element animates when it (or its data-mos-anchor) comes 100px into view, once
        const targets = new Map<Element, HTMLElement[]>();
        els.forEach((el) => {
          if (el.dataset.mosDelay) el.style.setProperty("--mos-delay", `${parseFloat(el.dataset.mosDelay)}s`);
          if (el.dataset.mosDuration) el.style.setProperty("--mos-duration", `${parseFloat(el.dataset.mosDuration)}s`);
          const anchor = (el.dataset.mosAnchor && document.querySelector(el.dataset.mosAnchor)) || el;
          targets.set(anchor, [...(targets.get(anchor) ?? []), el]);
        });
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              targets.get(entry.target)?.forEach((el) => el.classList.add("mos-animate"));
              io.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -100px 0px" },
        );
        targets.forEach((_, anchor) => io.observe(anchor));
      }

      initScrollAnimations();
      document.addEventListener("astro:after-swap", initScrollAnimations);
    </script>
  </body>
</html>
