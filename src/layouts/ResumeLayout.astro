---
import { type CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

import Button from "@/components/button/Button.astro";
import Certifications from "@/components/resume/Certifications.astro";
import Diplomas from "@/components/resume/Diplomas.astro";
import Experience from "@/components/resume/Experience.astro";
import HardSkills from "@/components/resume/HardSkills.astro";
import Languages from "@/components/resume/Languages.astro";
import SkillGroups from "@/components/resume/SkillGroups.astro";
import SoftSkills from "@/components/resume/SoftSkills.astro";
import Tools from "@/components/resume/Tools.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { useTranslations } from "@/js/translationUtils";
import { getLocalizedRoute } from "@/js/translationUtils";

import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  resume: CollectionEntry<"resume">;
}

const { title, description, resume } = Astro.props as Props;
const { summary, diplomas, experience, skillGroups, hardSkills, softSkills, certifications, languages, tools } =
  resume.data;

const currLocale = getLocaleFromUrl(Astro.url);
const t = useTranslations(currLocale);
---

<BaseLayout type="general" title={title} description={description}>
  <div class="site-container mt-32 md:mt-36">
    <div class="mx-auto max-w-4xl">
      <!-- Header -->
      <div class="mb-10 flex flex-col items-center justify-between gap-6 sm:flex-row">
        <div class="text-center sm:text-left">
          <h1 class="h1 mb-4">{title}</h1>
          <p class="text-muted-foreground">{description}</p>
        </div>

        <Button href="/Rotunno_Resume.pdf" download="Rotunno_Resume.pdf" variant="secondary">
          <div class="flex items-center gap-2">
            <span>Download CV</span>
            <Icon name="tabler/download" aria-hidden="true" class="size-5" />
          </div>
        </Button>
      </div>

      {
        summary && (
          <section class="border-primary-accent mb-16 border-l-4 pl-5">
            <h2 class="sr-only">Summary</h2>
            <p class="text-lg leading-relaxed md:text-xl">{summary}</p>
          </section>
        )
      }

      <!-- Resume Sections -->
      <div class="space-y-16 pb-10">
        <Experience {experience} />

        {skillGroups?.length ? <SkillGroups groups={skillGroups} /> : <HardSkills {hardSkills} />}

        <Diplomas {diplomas} />

        <div class="grid gap-8 md:grid-cols-2">
          <SoftSkills {softSkills} />
          <Languages {languages} />
        </div>

        {certifications.length > 0 && <Certifications {certifications} />}

        <Tools {tools} />
        <!-- you can also limit the number of tools to display here -->
        <!-- <Tools {tools} limit={4} /> -->
        <!-- <Button variant="secondary" href={getLocalizedRoute(currLocale, "/tools")} arrow="right">
					See all tools
				</Button> -->
      </div>
    </div>
  </div>

  <slot />
</BaseLayout>
